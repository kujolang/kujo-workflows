func get(value,key,fallback){if type(value)=="dict"&&has_key(value,key)==1{return value[key]};return fallback}
func flag(argv,name,fallback){mut i:=0;while i<len(argv){if argv[i]==name&&i+1<len(argv){return to_string(argv[i+1])};i=i+1};return fallback}
func ensure(path){if !path_is_dir(path){result:=spawn_process(["mkdir","-p",path],{"timeout_ms":5000});if result.exitcode!=0{return false}};return true}
func read_object(path){try{value:=parse_json(read_file(path));if type(value)=="dict"{return value}}except error{};return {}}
func write_json(path,value){write_file_atomic(path,to_json_pretty(value)+"\n",true)}

func main(){
    root:=path_absolute(".")
    argv:=args()
    output_arg:=flag(argv,"--out",".runs/publishing-house-e2e")
    output:=output_arg
    if !starts_with(output_arg,"/"){output=path_join(root,output_arg)}
    ensure(output)
    tool_state:=path_join(output,"tool-state")
    ensure(tool_state)
    workflows:=["publishing-house-governance","publishing-house-daily-desk","publishing-house-commissioning","publishing-house-evidence-dossier","publishing-house-primary-piece","publishing-house-asset-production","publishing-house-editorial-review","publishing-house-adaptation","publishing-house-format-production","publishing-house-approval-publication","publishing-house-post-publication"]
    runs:=[]
    for workflow in workflows {
        workflow_dir:=path_join(root,workflow)
        run_dir:=path_join(output,workflow)
        command:=[path_join(workflow_dir,"bin/run"),"--request",path_join(workflow_dir,"fixtures/request.fixture.json"),"--out",run_dir,"--tool-state-root",tool_state,"--json"]
        process:=spawn_process(command,{"cwd":workflow_dir,"timeout_ms":180000,"max_output_bytes":2097152})
        if process.exitcode!=0{eprint(workflow+" failed\n"+to_string(process.stdout)+to_string(process.stderr));exit(1)}
        first:=read_object(path_join(run_dir,"completion-receipt.json"))
        if workflow=="publishing-house-approval-publication" {
            if get(first,"outcome","")!="paused"{eprint("approval workflow did not pause");exit(1)}
            resume:=concat(command,["--resume","--fixture-approval",path_join(root,"fixtures/publishing-house/fixture-approval.fixture.json")])
            resumed:=spawn_process(resume,{"cwd":workflow_dir,"timeout_ms":180000,"max_output_bytes":2097152})
            if resumed.exitcode!=0{eprint("approval resume failed\n"+to_string(resumed.stdout)+to_string(resumed.stderr));exit(1)}
        }
        receipt:=read_object(path_join(run_dir,"completion-receipt.json"))
        if get(receipt,"outcome","")!="completed"{eprint(workflow+" did not complete");exit(1)}
        replay:=spawn_process(command,{"cwd":workflow_dir,"timeout_ms":60000,"max_output_bytes":1048576})
        if replay.exitcode!=0||contains(to_string(replay.stdout),"idempotent_replay")==0{eprint(workflow+" idempotent replay failed");exit(1)}
        runs=push(runs,{"workflow":workflow,"run_dir":run_dir,"receipt":path_join(run_dir,"completion-receipt.json"),"summary":path_join(run_dir,"run-summary.json")})
    }
    refs_checked:=0
    agents_checked:=0
    dispatch_checked:=0
    contract_preflights_checked:=0
    compatibility:=read_object(path_join(root,"docs/publishing-house/compatibility-matrix.json"))
    for run in runs {
        summary:=read_object(run["summary"])
        for ref in get(summary,"tool_record_references",[]){expected:=get(get(compatibility,"tools",{}),ref["tool"],{});if ref["tool_version"]!=get(expected,"version","")||ref["schema_version"]!=get(expected,"contract_version","")||!path_is_file(ref["path"])||sha256_file(ref["path"])!=ref["checksum"]{eprint("record reference failed: "+get(ref,"record_id","unknown"));exit(1)};refs_checked=refs_checked+1}
        for agent_path in get(summary,"agent_step_receipts",[]){agent:=read_object(agent_path);sdk:=get(get(agent,"agents_sdk",{}),"result",{});if get(agent,"outcome","")!="completed"||get(get(agent,"agents_sdk",{}),"requires_network",true)!=false||get(agent,"contract_loaded",false)!=true||get(agent,"instructions_sha256","")!=get(sdk,"instructions_sha256","/"){eprint("agent receipt failed");exit(1)};agents_checked=agents_checked+1}
        for dispatch in get(summary,"dispatch_artifacts",[]){if !path_is_file(dispatch["state"])||!path_is_file(dispatch["trace"]){eprint("Dispatch artifacts missing");exit(1)};dispatch_checked=dispatch_checked+1}
        capability:=read_object(path_join(run["run_dir"],"capability-receipt.json"))
        for entry in get(capability,"required",[]){if type(get(entry,"contract_preflight",null))=="dict"{if get(entry["contract_preflight"],"ok",false)!=true{eprint("contract preflight failed");exit(1)};if has_key(entry["contract_preflight"],"tool_version")==1{contract_preflights_checked=contract_preflights_checked+1}}}
    }
    approval_dir:=path_join(output,"publishing-house-approval-publication")
    checksums:=read_object(path_join(approval_dir,"artifact-checksums.json"))
    values:=get(checksums,"checksums",[])
    if len(values)!=2||values[0]["checksum"]!=values[1]["checksum"]{eprint("approval and publication checksums do not match");exit(1)}
    publication_id:="publication-"+substring(sha256("approve-fixture-v2\npublish\nfixture-local\n"+values[0]["checksum"]),0,20)
    required_records:=["campaign-fixture-governance","review-fixture-developmental-v1","artifact-fixture-primary-v2","artifact-fixture-adaptation-plan","artifact-fixture-format-package","approve-fixture-v2",publication_id,"followup-fixture-publication","idea-fixture-followup"]
    for id in required_records {
        found:=false
        for tool in ["storydesk","dossier","galleypack","bluepencil","versionseal","presswire","readersignal","assetworks"]{if path_is_file(path_join(tool_state,tool+"/records/"+id+".json")){found=true}}
        if !found{eprint("required integration record missing: "+id);exit(1)}
    }
    proof:={
        "schema_name":"publishing-house.integration-proof","schema_version":"1.0.0","fixture":true,"offline":true,"network_calls":0,
        "correlation_id":"correlation-publishing-house-fixture","workflow_count":len(runs),"workflows":runs,"record_references_checked":refs_checked,
        "agent_receipts_checked":agents_checked,"dispatch_runs_checked":dispatch_checked,"tool_contract_preflights_checked":contract_preflights_checked,"revision_loop":"passed","approval_pause_resume":"passed",
        "idempotency":"passed","package_checksum":values[0]["checksum"],"publication_checksum":values[1]["checksum"],
        "external_effect":"bounded local fixture copy only","live_publication":false,"credentials_required":false
    }
    proof_path:=path_join(output,"integration-proof.json")
    write_json(proof_path,proof)
    print(to_json_pretty({"ok":true,"proof":proof_path,"workflow_count":len(runs),"record_references_checked":refs_checked,"tool_contract_preflights_checked":contract_preflights_checked,"agent_receipts_checked":agents_checked}))
}
main()
