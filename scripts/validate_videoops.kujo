func get(value,key,fallback){if type(value)=="dict"&&has_key(value,key)==1{return value[key]};return fallback}
func flag(argv,name,fallback){mut i:=0;while i<len(argv){if argv[i]==name&&i+1<len(argv){return to_string(argv[i+1])};i=i+1};return fallback}
func load(path){if !path_is_file(path){return {"ok":false,"error":"missing: "+path}};try{value:=parse_json(read_file(path));if type(value)=="dict"{return {"ok":true,"value":value}}}except error{};return {"ok":false,"error":"invalid JSON object: "+path}}
func add(errors,message){return push(errors,message)}
func has_all(value,fields){
    if type(value)!="dict" { return false }
    for field in fields { if has_key(value,field)!=1 { return false } }
    return true
}
func valid_shot(value){
    if has_all(value,["id","start","end","duration","purpose","visual","priority"])!=true { return false }
    if get(value,"start",-1)<0 { return false }
    if get(value,"end",0)<=get(value,"start",0) { return false }
    if get(value,"duration",0)<=0 { return false }
    return true
}
func valid_asset(value){
    if has_all(value,["id","requirement_id","type","origin","status","usage_status","used_by"])!=true { return false }
    status:=get(value,"status","");usage:=get(value,"usage_status","")
    if contains("FOUND,CAPTURED,GENERATE,NOT_REQUIRED,BLOCKED",status)!=1 { return false }
    if contains("approved,reference-only,blocked,pending",usage)!=1 { return false }
    return true
}
func valid_issue(value){
    if has_all(value,["id","severity","problem","why_it_matters","required_change","acceptance_criteria","implementation_status"])!=true { return false }
    if get(value,"problem","")=="" { return false }
    if get(value,"acceptance_criteria","")=="" { return false }
    return true
}

func main(){
    root:=path_absolute(".");repos:=dirname(root);mut errors:=[]
    workflows:=[
        ["videoops-creative-planning","videoops.creative-director","economical-general"],
        ["videoops-asset-resolution","videoops.asset-scout","economical-general"],
        ["videoops-media-generation","videoops.media-generator","economical-general"],
        ["videoops-hyperframes-edit","videoops.hyperframes-editor","economical-code"],
        ["videoops-quality-review","videoops.video-critic","economical-multimodal"]
    ]
    production:=load(path_join(root,"videoops-production/workflow.json"));if !production["ok"]{errors=add(errors,production["error"])}else{item:=production["value"];if get(item,"agent","")!="videoops.producer"||get(item,"live_mode",false)!=true||get(item,"fixture_mode",true)!=false{errors=add(errors,"videoops-production identity/mode mismatch")};for skill in get(item,"skills",[]){if !path_is_file(path_join(repos,"kujo-skills/skills/"+skill+"/SKILL.md")){errors=add(errors,"videoops-production: unresolved skill "+skill)}}}
    for path in [path_join(root,"videoops-production/workflow.kujo"),path_join(root,"videoops-production/README.md"),path_join(root,"videoops-production/bin/run")]{if !path_is_file(path){errors=add(errors,"videoops-production: missing "+path)}}
    for row in workflows{
        id:=row[0];for path in [path_join(root,id+"/workflow.kujo"),path_join(root,id+"/workflow.json"),path_join(root,id+"/README.md"),path_join(root,id+"/bin/run")]{if !path_is_file(path){errors=add(errors,id+": missing "+path)}}
        loaded:=load(path_join(root,id+"/workflow.json"));if loaded["ok"]{item:=loaded["value"];if get(item,"schema","")!="videoops.workflow/v1"||get(item,"agent","")!=row[1]||get(item,"model_profile","")!=row[2]{errors=add(errors,id+": identity/model mismatch")};if get(item,"live_mode",true)!=false{errors=add(errors,id+": fixture release must not claim live mode")};for skill in get(item,"skills",[]){if !path_is_file(path_join(repos,"kujo-skills/skills/"+skill+"/SKILL.md")){errors=add(errors,id+": unresolved skill "+skill)}}}else{errors=add(errors,loaded["error"])}
    }
    agent_catalog:=load(path_join(repos,"kujo-agents/videoops/videoops-catalog.json"));if !agent_catalog["ok"]||get(agent_catalog["value"],"agent_count",0)!=6{errors=add(errors,"VideoOps Producer and five-specialist catalog unavailable")}
    for schema in ["shot-list","asset-manifest","approval","fix-list","project-state","handoff","escalation"]{loaded:=load(path_join(repos,"kujo-agents/schemas/videoops/"+schema+".schema.json"));if !loaded["ok"]{errors=add(errors,loaded["error"])}else if get(loaded["value"],"$schema","")!="https://json-schema.org/draft/2020-12/schema"{errors=add(errors,schema+": wrong dialect")}}
    routing:=load(path_join(root,"contracts/videoops/model-routing.v1.json"));if !routing["ok"]{errors=add(errors,routing["error"])}else{policy:=routing["value"];if get(policy,"provider_binding","bound")!=null||get(policy,"max_economical_attempts_per_stage",0)!=2||get(policy,"max_editor_critic_revision_cycles",0)!=3||get(policy,"escalation_scope","")!="failing-stage-only"{errors=add(errors,"model routing policy mismatch")}}
    valid_shot_fixture:={"id":"s1","start":0,"end":1,"duration":1,"purpose":"hook","visual":"type","priority":"required"};invalid_shot_fixture:={"id":"s1","start":1,"end":0,"duration":0};if valid_shot(valid_shot_fixture)!=true||valid_shot(invalid_shot_fixture)==true{errors=add(errors,"shot-list positive/negative validation failed")}
    valid_asset_fixture:={"id":"a1","requirement_id":"r1","type":"image","origin":"first-party","status":"FOUND","usage_status":"approved","used_by":["s1"]};invalid_asset_fixture:={"id":"a1","status":"PUBLIC_URL_MEANS_LICENSE"};if valid_asset(valid_asset_fixture)!=true||valid_asset(invalid_asset_fixture)==true{errors=add(errors,"asset-manifest positive/negative validation failed")}
    valid_issue_fixture:={"id":"f1","severity":"HIGH","problem":"low contrast","why_it_matters":"CTA unreadable","required_change":"use white","acceptance_criteria":"contrast passes","implementation_status":"PENDING"};invalid_issue_fixture:={"id":"f1","problem":"make it cooler"};if valid_issue(valid_issue_fixture)!=true||valid_issue(invalid_issue_fixture)==true{errors=add(errors,"fix-list positive/negative validation failed")}
    source_scan:=spawn_process(["find",path_join(root,"lib/videoops"),path_join(root,"videoops-production"),path_join(root,"videoops-creative-planning"),path_join(root,"videoops-asset-resolution"),path_join(root,"videoops-media-generation"),path_join(root,"videoops-hyperframes-edit"),path_join(root,"videoops-quality-review"),"-type","f","-name","*.py"],{"timeout_ms":5000,"max_output_bytes":65536});if trim(to_string(source_scan.stdout))!=""{errors=add(errors,"VideoOps implementation contains Python source")}
    proof_path:=flag(args(),"--proof","")
    if proof_path!=""{proof_loaded:=load(proof_path);if !proof_loaded["ok"]{errors=add(errors,proof_loaded["error"])}else{proof:=proof_loaded["value"];checks:={"schema":"videoops.integration-proof/v1","fixture":true,"offline":true,"production_orchestrator":false,"network_calls":0,"paid_calls":0,"credentials_used":false,"agent_stage_count":5,"successful_stage_receipts":8,"editor_unresolved_asset_gate":"passed","creative_plan_gate":"passed","asset_accounting":"passed","generator_only_generate_gate":true,"hyperframes_real_render":"passed","audio_stream_gate":"passed","audio_fixture":"deterministic-local-reference-tone","hyperframes_version":"0.8.27","render_width":1920,"render_height":1080,"render_fps":30,"render_duration_seconds":6,"first_review":"FAIL","revision_limit_gate":"passed","revision_fix_status":"APPLIED","second_review":"PASS","revision_loop":"passed","final_exists":true,"final_sha256_present":true,"manifest_assets":2,"runledger_status":"pass","runledger_input_tokens":0,"runledger_output_tokens":0,"runledger_total_cost_usd":0,"packwrite_boundary":"validated-and-linked","stage_local_escalation":"passed","max_economical_attempts":2,"max_revision_cycles":3,"stage_output_schema_gate":"passed","artifact_schema_gate":"passed","project_state_gate":"passed","handoff_schema_gate":"passed","escalation_schema_gate":"passed"};for key in keys(checks){if get(proof,key,null)!=checks[key]{errors=add(errors,"proof mismatch: "+key)}}}}
    result:={"valid":len(errors)==0,"agents":6,"specialist_stages":5,"workflows":6,"skills":36,"schemas":7,"positive_negative_schema_fixtures":3,"proof_checked":proof_path!="","errors":errors};print(to_json_pretty(result));if len(errors)>0{exit(1)}
}
main()
