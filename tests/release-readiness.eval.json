{
  "name": "Kujo Workflows technical preview",
  "description": "Make the repository's technical-preview release surface portable, truthful, legally distributable, continuously validated, and reproducible from a clean checkout.",
  "tests": [
    {
      "name": "Validate the task Spec in strict mode.",
      "check": "command_succeeds",
      "params": {
        "command": "spec validate kujo-workflows.spec.yml --strict"
      }
    },
    {
      "name": "Validate repository documentation and release metadata.",
      "check": "command_succeeds",
      "params": {
        "command": "python3 scripts/validate_docs.py"
      }
    },
    {
      "name": "Run repository unit tests.",
      "check": "command_succeeds",
      "params": {
        "command": "python3 -m unittest discover -s tests -p 'test_*.py'"
      }
    },
    {
      "name": "Run the portable release-readiness gate.",
      "check": "command_succeeds",
      "params": {
        "command": "bash tests/release-readiness.sh"
      }
    },
    {
      "name": "Run the tracked-file clean-checkout gate.",
      "check": "command_succeeds",
      "params": {
        "command": "bash tests/clean-checkout.sh"
      }
    },
    {
      "name": "Run the strict agency workflow.",
      "check": "command_succeeds",
      "params": {
        "command": "agency-runner/bin/agency-loop demo-verified-loop --strict"
      }
    },
    {
      "name": "Pass the ShipCheck release gate.",
      "check": "command_succeeds",
      "params": {
        "command": "kujo run ../shipcheck/shipcheck.kujo gate --dir . --format json"
      }
    }
  ]
}
