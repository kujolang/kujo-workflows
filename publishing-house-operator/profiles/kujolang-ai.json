  "author_policy": {"default": "Kujo Publishing House"}, "claim_policy": {"new_public_claims": "escalate", "readiness": "must-match-source"}, "evidence_policy": {"source_mapping": true, "required_for": ["capability", "readiness", "performance", "security"]}, "research_policy": {"prefer": ["repository", "tests", "release-artifacts", "official-docs"]},
  "linking_policy": {"internal": "contentgraph", "external": "verified"}, "seo_policy": {"canonical": true, "sitemap": true, "structured_data": true}, "ai_search_policy": {"llms_txt": true, "source_clarity": true}, "asset_policy": {"social_card": "required", "howl_manifest": "howl-social.json", "alt_text": "required", "rights_metadata": "required"}, "accessibility": {"wcag": "2.2 AA"},
  "build": {"commands": ["npm run social:cards", "kujo run ./build.kujo -- --site-url https://kujolang.ai"], "tests": ["bash scripts/verify-site-contract.sh output", "bash scripts/validate-generated-output.sh output", "npm run social:verify", "node --check assets/js/site.js", "npm audit --omit=dev"], "preview": "bash scripts/dev.sh 4178"},
