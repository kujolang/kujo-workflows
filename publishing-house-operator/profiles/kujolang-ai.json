{
  "schema_name": "publishing-house.publication-profile", "schema_version": "1.0.0", "id": "kujolang-ai",
  "identity": {"name": "kujolang.ai", "canonical_url": "https://kujolang.ai"}, "publication_type": "product-and-ecosystem-site",
  "canonical_repository": "../kujolang.ai",
  "source_of_truth": {"content": ["content/pages", "content/ecosystem", "content/skills", "content/workflows", "content/posts"], "assets": ["howl-social.json", "assets"], "generated": ["output"], "never_edit": ["output"]},
  "audience": "developers and teams evaluating or using Kujo", "editorial_mission": "Explain the Kujo language and ecosystem accurately through source-backed, useful content.",
  "voice_profile": "voices/kujolang.json", "style_rules": ["Lead with verified capability", "State readiness boundaries", "Avoid inflated claims"], "terminology": {"Kujo": "Kujo", "SiteKit": "SiteKit"}, "avoided_patterns": ["revolutionary", "game-changing", "effortless"],
  "content_formats": ["writing-post", "ecosystem-page", "workflow-page", "skill-page", "release-note", "metadata-fix", "social-card-sync"],
