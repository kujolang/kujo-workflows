{
  "schema_name": "publishing-house.publication-profile",
  "schema_version": "1.0.0",
  "id": "personal-blog",
  "identity": {"name": "RobertDeVore.com", "canonical_url": "https://robertdevore.com"},
  "publication_type": "personal-technical-blog",
  "canonical_repository": "../../robertdevore.com",
  "source_of_truth": {"content": ["content/posts", "content/pages"], "generated": ["output"], "never_edit": ["output"]},
  "audience": "developers, builders, technical founders, and Kujo readers",
  "editorial_mission": "Publish Robert DeVore's technical observations, build logs, arguments, and research-backed essays in his own perspective.",
  "voice_profile": "voices/robert-devore.json",
  "style_rules": ["Use first person when the judgment is the author's", "Prefer concrete implementation detail", "Do not convert personal arguments into corporate marketing copy"],
  "terminology": {"Kujo": "Kujo", "AI-native": "AI-native"},
  "avoided_patterns": ["The bigger idea became", "It started from a simple frustration", "Let's dive in", "In today's fast-paced", "This distinction matters because"],
  "content_formats": ["technical-essay", "build-log", "architectural-argument", "research-essay", "release-explanation", "personal-observation", "metadata-fix"],
  "frontmatter": {"format": "yaml", "required": ["title", "date", "description", "author", "slug"], "author": "Robert DeVore"},
  "author_policy": {"allowed": ["Robert DeVore"], "default": "Robert DeVore"},
  "claim_policy": {"new_public_claims": "escalate", "security_legal_competitive": "human-review"},
  "evidence_policy": {"required_for": ["technical", "comparative", "quantitative", "security"], "source_mapping": true},
  "research_policy": {"prefer": ["primary-source", "repository", "tests", "official-docs"]},
  "linking_policy": {"internal": "relevant-only", "external": "source-backed"},
  "seo_policy": {"title": true, "description": true, "canonical": true, "sitemap": true, "rss": true},
  "ai_search_policy": {"llms_txt": true, "answerable_structure": true, "no_keyword_stuffing": true},
  "asset_policy": {"hero": "optional", "social_card": "required", "alt_text": "required", "rights_metadata": "required"},
  "accessibility": {"wcag": "2.2 AA", "semantic_html": true, "keyboard": true},
  "build": {"commands": ["./scripts/sync_dependencies.sh --check", "./scripts/build.sh"], "tests": ["python3 scripts/validate_site.py output", "python3 scripts/bundle_css.py --check"], "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory output"},
  "deployment": {"adapter": "presswire-git-static", "branch": "main", "mechanism": "GitHub Pages workflow", "destination": "https://robertdevore.com", "generated_output_committed": false},
  "verification": {"status": 200, "metadata": ["canonical", "title", "description", "og", "x", "structured-data"], "checks": ["links", "accessibility", "desktop", "mobile", "console", "sitemap", "rss"]},
  "measurement": {"adapters": ["readersignal", "webops-post-publish"]},
  "approval_policy": {"default": "REQUIRE_EXACT_HUMAN_APPROVAL", "automatic_classes": ["metadata-fix"], "escalate": ["new-public-claim", "security", "legal", "competitive"]},
  "refresh_policy": {"cadence_days": 180, "signals": ["stale-evidence", "broken-link", "search-decay"]},
  "correction_policy": {"invalidate_approval_on_change": true, "record_reason": true, "rollback": "git-revert", "unpublish": "explicit-human-approval"}
}
