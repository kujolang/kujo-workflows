{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/contracts/workcell/work-package/v1",
  "title": "Kujo Workcell work package v1",
  "type": "object",
  "required": ["contract", "contract_version", "package_id", "created_at", "workflow_ref", "run_ref", "step_ref", "source", "execution", "artifacts", "verification", "provenance", "redaction", "idempotency_key"],
  "properties": {
    "contract": {"const": "kujo.workcell.work-package"},
    "contract_version": {"const": "1.0"},
    "package_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "workflow_ref": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "run_ref": {"type": "object", "required": ["id", "attempt"], "properties": {"id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 0}}},
    "step_ref": {"type": "object", "required": ["id", "sequence"], "properties": {"id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 0}}},
    "source": {"type": "object", "required": ["repository", "commit", "dirty_allowed"], "properties": {"repository": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1}, "dirty_allowed": {"type": "boolean"}}},
    "execution": {"type": "object", "required": ["runtime_backend", "workspace_strategy", "command", "resource_limits", "network_mode"], "properties": {"runtime_backend": {"enum": ["docker", "podman"]}, "workspace_strategy": {"type": "string", "minLength": 1}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "resource_limits": {"type": "object", "required": ["timeout_ms", "max_output_bytes"], "properties": {"timeout_ms": {"type": "integer", "minimum": 1}, "max_output_bytes": {"type": "integer", "minimum": 1}}}, "network_mode": {"type": "string", "minLength": 1}}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "required"], "properties": {"path": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}}},
    "verification": {"type": "object", "required": ["required", "commands"], "properties": {"required": {"type": "boolean"}, "commands": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}}},
    "provenance": {"type": "object", "required": ["source_tool", "source_version", "artifact_refs"], "properties": {"source_tool": {"type": "string", "minLength": 1}, "source_version": {"type": "string", "minLength": 1}, "source_commit": {"type": "string"}, "artifact_refs": {"type": "array", "items": {"type": "string"}}}},
    "redaction": {"type": "object", "required": ["policy", "redacted_fields"], "properties": {"policy": {"type": "string", "minLength": 1}, "redacted_fields": {"type": "array", "items": {"type": "string"}}}},
    "idempotency_key": {"type": "string", "minLength": 1},
    "error": {"type": "object", "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}}}
  }
}
