{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/contracts/workcell/completion-receipt/v1",
  "title": "Kujo Workcell completion receipt v1",
  "type": "object",
  "required": ["contract", "contract_version", "package_id", "created_at", "workflow_ref", "run_ref", "step_ref", "run_id", "status", "lifecycle", "execution", "artifacts", "provenance", "redaction"],
  "properties": {
    "contract": {"const": "kujo.workcell.completion-receipt"},
    "contract_version": {"const": "1.0"},
    "package_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "workflow_ref": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "run_ref": {"type": "object", "required": ["id", "attempt"], "properties": {"id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 0}}},
    "step_ref": {"type": "object", "required": ["id", "sequence"], "properties": {"id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 0}}},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "cancelled", "blocked"]},
    "lifecycle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "execution": {"type": "object", "required": ["runtime_backend", "cleanup_status", "receipt_path", "manifest_path"], "properties": {"runtime_backend": {"enum": ["docker", "podman"]}, "cleanup_status": {"enum": ["complete", "partial", "failed", "not_run"]}, "receipt_path": {"type": "string", "minLength": 1}, "manifest_path": {"type": "string", "minLength": 1}, "source_commit": {"type": "string"}, "definition_hash": {"type": "string"}}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "status": {"enum": ["exported", "missing", "rejected", "not_requested"]}, "sha256": {"type": "string"}}}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}}}},
    "provenance": {"type": "object", "required": ["source_tool", "source_version", "artifact_refs"], "properties": {"source_tool": {"type": "string", "minLength": 1}, "source_version": {"type": "string", "minLength": 1}, "source_commit": {"type": "string"}, "artifact_refs": {"type": "array", "items": {"type": "string"}}}},
    "redaction": {"type": "object", "required": ["policy", "redacted_fields"], "properties": {"policy": {"type": "string", "minLength": 1}, "redacted_fields": {"type": "array", "items": {"type": "string"}}}}
  }
}
