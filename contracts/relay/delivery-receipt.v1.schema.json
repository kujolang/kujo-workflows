{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/contracts/relay/delivery-receipt/v1",
  "title": "Kujo Relay delivery receipt v1",
  "type": "object",
  "required": ["contract", "contract_version", "message_id", "correlation_id", "status", "attempts", "transport", "provenance", "redaction"],
  "properties": {
    "contract": {"const": "kujo.relay.delivery-receipt"},
    "contract_version": {"const": "1.0"},
    "message_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "delivered", "acknowledged", "retrying", "dead_lettered", "failed"]},
    "attempts": {"type": "integer", "minimum": 1},
    "transport": {"enum": ["local_store", "relay_cli", "external_provider"]},
    "acknowledged_at": {"type": "string"},
    "next_action": {"enum": ["none", "retry", "operator_review", "resume_workflow"]},
    "error": {"type": "object", "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}}},
    "provenance": {"type": "object", "required": ["source_tool", "source_version", "artifact_refs"], "properties": {"source_tool": {"type": "string", "minLength": 1}, "source_version": {"type": "string", "minLength": 1}, "source_commit": {"type": "string"}, "artifact_refs": {"type": "array", "items": {"type": "string"}}}},
    "redaction": {"type": "object", "required": ["policy", "redacted_fields"], "properties": {"policy": {"type": "string", "minLength": 1}, "redacted_fields": {"type": "array", "items": {"type": "string"}}}}
  }
}
