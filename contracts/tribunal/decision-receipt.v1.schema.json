{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujo.dev/contracts/tribunal/decision-receipt/v1",
  "title": "Kujo Tribunal decision receipt v1",
  "type": "object",
  "required": ["contract", "contract_version", "decision_id", "workflow_ref", "run_ref", "step_ref", "decision", "participants", "evidence", "provenance", "redaction", "idempotency_key"],
  "properties": {
    "contract": {"const": "kujo.tribunal.decision-receipt"},
    "contract_version": {"const": "1.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "workflow_ref": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "run_ref": {"type": "object", "required": ["id", "attempt"], "properties": {"id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 0}}},
    "step_ref": {"type": "object", "required": ["id", "sequence"], "properties": {"id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 0}}},
    "decision": {
      "type": "object",
      "required": ["status", "binding", "confidence", "rationale", "quorum"],
      "properties": {
        "status": {"enum": ["approved", "rejected", "unresolved", "escalated"]},
        "binding": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "quorum": {"type": "object", "required": ["required", "achieved"], "properties": {"required": {"type": "integer", "minimum": 1}, "achieved": {"type": "integer", "minimum": 0}}},
        "dissent": {"type": "array", "items": {"type": "object", "required": ["participant", "summary"], "properties": {"participant": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}}}},
        "escalation": {"type": "object", "properties": {"required": {"type": "boolean"}, "reason": {"type": "string"}, "target": {"type": "string"}}}
      }
    },
    "participants": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "role", "outcome"], "properties": {"id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "outcome": {"enum": ["agree", "disagree", "abstain", "unavailable"]}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "uri"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "sha256": {"type": "string"}}}},
    "tool_receipt": {"type": "object", "required": ["tool", "run_id", "integrity_status"], "properties": {"tool": {"const": "tribunal"}, "run_id": {"type": "string", "minLength": 1}, "integrity_status": {"enum": ["verified", "unsigned", "failed"]}, "signature_status": {"enum": ["present", "absent", "invalid"]}}},
    "provenance": {"type": "object", "required": ["source_tool", "source_version", "artifact_refs"], "properties": {"source_tool": {"type": "string", "minLength": 1}, "source_version": {"type": "string", "minLength": 1}, "source_commit": {"type": "string"}, "artifact_refs": {"type": "array", "items": {"type": "string"}}}},
    "redaction": {"type": "object", "required": ["policy", "redacted_fields"], "properties": {"policy": {"type": "string", "minLength": 1}, "redacted_fields": {"type": "array", "items": {"type": "string"}}}},
    "idempotency_key": {"type": "string", "minLength": 1},
    "error": {"type": "object", "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}}}
  }
}
