export func get(value, key, fallback) {
    if type(value) == "dict" && has_key(value, key) == 1 { return value[key] }
    return fallback
}

func flag(argv, name, fallback) {
    mut i := 0
    while i < len(argv) {
        if argv[i] == name && i + 1 < len(argv) { return to_string(argv[i + 1]) }
        i = i + 1
    }
    return fallback
}

func has_flag(argv, name) {
    mut i := 0
    while i < len(argv) {
        if argv[i] == name { return true }
        i = i + 1
    }
    return false
}

func ensure_dir(path) {
    if !path_is_dir(path) {
        result := spawn_process(["mkdir", "-p", path], {"timeout_ms":5000,"max_output_bytes":65536})
        if result.exitcode != 0 { return {"ok":false,"error":"cannot create directory: " + path} }
    }
    return {"ok":true}
}

func write_text(path, value) {
    made := ensure_dir(dirname(path))
    if !made["ok"] { return made }
    write_file_atomic(path, value, true)
    return {"ok":true}
}

func write_json(path, value) { return write_text(path, to_json_pretty(value) + "\n") }

func load_object(path) {
    if !path_is_file(path) { return {"ok":false,"code":"missing_input","error":"missing required input: " + path} }
    if path_is_symlink(path) || file_size(path) > 1048576 { return {"ok":false,"code":"unsafe_input","error":"input is unsafe or too large: " + path} }
    try {
        value := parse_json(read_file(path))
        if type(value) != "dict" { return {"ok":false,"code":"invalid_json","error":"expected JSON object: " + path} }
        return {"ok":true,"value":value}
    } except error { return {"ok":false,"code":"invalid_json","error":"invalid JSON: " + path} }
}

func safe_workspace(path) {
    absolute := path_absolute(path)
    if absolute == "/" || absolute == "/Users" || absolute == "/tmp" { return {"ok":false,"error":"refusing broad or invalid workspace"} }
    return {"ok":true,"path":absolute}
}

func artifact_paths(workspace, names) {
    result := []
    for name in names { result = push(result, path_join(workspace, name)) }
    return result
}

func require_files(workspace, names) {
    missing := []
    for name in names {
        path := path_join(workspace, name)
        if !path_is_file(path) || path_is_symlink(path) { missing = push(missing, name) }
    }
    if len(missing) > 0 { return {"ok":false,"code":"missing_input","error":"missing required inputs: " + join(missing, ", "),"missing":missing} }
    return {"ok":true}
}

func event(workspace, run_id, stage, state, detail) {
    events_path := path_join(workspace, "review/evidence/events.ndjson")
    made := ensure_dir(dirname(events_path))
    if !made["ok"] { return }
    previous := ""
    if path_is_file(events_path) { previous = read_file(events_path) }
    record := {"schema":"videoops.event/v1","run_id":run_id,"stage":stage,"state":state,"detail":detail,"fixture_time":"2026-09-04T12:00:00-04:00"}
    write_file_atomic(events_path, previous + to_json(record) + "\n", true)
    state_path := path_join(workspace, "review/project-state.json")
    revision_count := 0
    if path_is_file(state_path) {
        loaded := load_object(state_path)
        if loaded["ok"] { revision_count = get(loaded["value"], "revision_count", 0) }
    }
    if state == "REVISION_REQUIRED" && revision_count < 3 { revision_count = revision_count + 1 }
    if state == "BLOCKED" && stage == "video-critic" { revision_count = 3 }
    write_json(state_path, {
        "state":state,"run_id":run_id,"revision_count":revision_count,
        "updated_at":"2026-09-04T12:00:00-04:00","notes":detail
    })
}

func handoff(workspace, run_id, current_owner, next_owner, goal, artifacts, evidence, stop_condition) {
    value := {
        "schema":"kujo.handoff/v1","assignment":run_id + ":" + current_owner,"current_owner":current_owner,"next_owner":next_owner,
        "goal":goal,"scope":"bounded VideoOps fixture workspace","artifacts":artifacts,"evidence":evidence,"decisions":[],
        "unresolved_questions":[],"allowed_next_actions":["validate declared inputs","run the next bounded VideoOps stage"],"stop_condition":stop_condition
    }
    path := path_join(workspace, "review/evidence/handoffs/" + current_owner + ".json")
    write_json(path, value)
    return path
}

func premium_profile(stage) {
    if stage == "creative-director" || stage == "asset-scout" || stage == "media-generator" { return "premium-creative" }
    return "premium-multimodal"
}

func stage_receipt(workspace, run_id, stage, outcome, artifacts, evidence, model_profile, attempt, handoff_path) {
    effective_profile := model_profile
    if attempt > 2 { effective_profile = premium_profile(stage) }
    receipt := {"schema":"videoops.stage-receipt/v1","run_id":run_id,"stage":stage,"outcome":outcome,"artifacts":artifacts,"evidence":evidence,"model_profile":effective_profile,"attempt":attempt,"handoff":handoff_path,"fixture":true,"external_calls":0}
    path := path_join(workspace, "review/evidence/stages/" + stage + "-attempt-" + to_string(attempt) + ".json")
    write_json(path, receipt)
    return receipt
}

func blocked(workspace, run_id, stage, code, message, profile, attempt) {
    event(workspace, run_id, stage, "BLOCKED", message)
    receipt := {"schema":"videoops.stage-receipt/v1","run_id":run_id,"stage":stage,"outcome":"blocked","code":code,"error":message,"artifacts":[],"evidence":[],"model_profile":profile,"attempt":attempt,"fixture":true,"external_calls":0}
    write_json(path_join(workspace, "review/evidence/stages/" + stage + "-attempt-" + to_string(attempt) + ".json"), receipt)
    return receipt
}

func creative_stage(workspace, run_id, attempt) {
    required := ["intake/project-brief.md","intake/messaging.md","intake/audience.md","intake/constraints.md","intake/references.md","intake/platform.json"]
    checked := require_files(workspace, required)
    if !checked["ok"] { return blocked(workspace, run_id, "creative-director", checked["code"], checked["error"], "economical-general", attempt) }
    platform_loaded := load_object(path_join(workspace, "intake/platform.json"))
    if !platform_loaded["ok"] { return blocked(workspace, run_id, "creative-director", platform_loaded["code"], platform_loaded["error"], "economical-general", attempt) }
    platform := platform_loaded["value"]
    duration := get(platform, "target_duration_seconds", 6)
    if type(duration) != "int" && type(duration) != "float" { return blocked(workspace, run_id, "creative-director", "invalid_platform", "target_duration_seconds must be numeric", "economical-general", attempt) }
    write_text(path_join(workspace, "planning/creative-brief.md"), "# Creative Brief\n\nThesis: an agent should be an inspectable software project, not one opaque prompt.\n\nAudience: developers evaluating Kujo.\n\nPromise: explicit files make work reviewable and continuable.\n\nCTA: inspect the project, then run the concrete Kujo command.\n\nEvidence boundary: use only supplied first-party Kujo material; do not invent product behavior.\n")
    write_text(path_join(workspace, "planning/transcript.md"), "# Transcript\n\n00:00–00:02 VO: An agent should not be one giant prompt.\n\n00:02–00:04 VO: It should be an inspectable software project.\n\n00:04–00:06 VO: Files. Boundaries. Evidence. Then run Kujo.\n\nOnscreen CTA: kujo run agent.kujo\n")
    shots := [
        {"id":"shot-001","start":0,"end":2,"duration":2,"purpose":"hook","visual":"Large contrast statement","audio":"voiceover","voiceover":"An agent should not be one giant prompt.","onscreen_text":"NOT ONE GIANT PROMPT","asset_ids":[],"asset_requirement_ids":["asset-001"],"transition_in":null,"transition_out":"hard-cut","motion":"abrupt scale","priority":"required"},
        {"id":"shot-002","start":2,"end":4,"duration":2,"purpose":"thesis","visual":"First-party project files plus generated evidence grid","audio":"voiceover","voiceover":"It should be an inspectable software project.","onscreen_text":"FILES / BOUNDARIES / EVIDENCE","asset_ids":[],"asset_requirement_ids":["asset-001","asset-002"],"transition_in":"hard-cut","transition_out":"hard-cut","motion":"horizontal punch-in","priority":"required"},
        {"id":"shot-003","start":4,"end":duration,"duration":duration-4,"purpose":"cta","visual":"Concrete Kujo command","audio":"voiceover","voiceover":"Files. Boundaries. Evidence. Then run Kujo.","onscreen_text":"kujo run agent.kujo","asset_ids":[],"asset_requirement_ids":[],"transition_in":"hard-cut","transition_out":null,"motion":"hold with cursor pulse","priority":"required"}
    ]
    write_json(path_join(workspace, "planning/shot-list.json"), {"shots":shots})
    write_text(path_join(workspace, "planning/style-plan.md"), "# Style Plan\n\nPaper-white and ink-black, editorial and technical. Three two-second beats with hard cuts, extreme type scale, one generated evidence-grid insert, and no decorative glitch. Speech changes land on cuts. The CTA must meet strong contrast and remain readable for the final two seconds.\n")
    requirements := [
        {"id":"asset-001","type":"first-party-capture","description":"Approved first-party Kujo project-file visual","required":true,"used_by":["shot-001","shot-002"],"preferred_source":"intake/first-party-project.svg","acceptance":"local, rights-known, readable at 1920x1080"},
        {"id":"asset-002","type":"generated-still","description":"Monochrome evidence grid with negative space","required":true,"used_by":["shot-002"],"preferred_source":"generated","acceptance":"1920x1080-compatible SVG, no generic AI motifs"}
    ]
    write_json(path_join(workspace, "planning/asset-requirements.json"), {"requirements":requirements})
    gate := {"schema":"videoops.creative-eval/v1","threshold":85,"score":92,"dimensions":{"narrative_clarity":95,"hook_strength":90,"visual_variety":86,"executability":96,"brand_alignment":94,"originality":86,"platform_fit":94,"timing_completeness":100,"asset_plan_quality":90},"outcome":"PASS"}
    gate_path := path_join(workspace, "review/evidence/creative-eval.json")
    write_json(gate_path, gate)
    artifacts := artifact_paths(workspace, ["planning/creative-brief.md","planning/transcript.md","planning/shot-list.json","planning/style-plan.md","planning/asset-requirements.json"])
    next := handoff(workspace, run_id, "creative-director", "asset-scout", "Resolve the approved asset requirements", artifacts, [gate_path], "Every asset requirement has a terminal status")
    event(workspace, run_id, "creative-director", "PLANNING_READY", "planning artifacts and creative gate passed")
    return stage_receipt(workspace, run_id, "creative-director", "completed", artifacts, [gate_path], "economical-general", attempt, next)
}

func asset_stage(workspace, run_id, attempt) {
    checked := require_files(workspace, ["planning/creative-brief.md","planning/shot-list.json","planning/asset-requirements.json","intake/first-party-project.svg"])
    if !checked["ok"] { return blocked(workspace, run_id, "asset-scout", checked["code"], checked["error"], "economical-general", attempt) }
    source := path_join(workspace, "intake/first-party-project.svg")
    assets := [
        {"id":"asset-001","requirement_id":"asset-001","type":"image/svg+xml","origin":"first-party","status":"FOUND","path":source,"source_url":null,"license":"first-party project fixture","creator":"Kujo fixture","retrieved_at":"2026-09-04","usage_status":"approved","used_by":["shot-001","shot-002"],"generation_purpose":null},
        {"id":"asset-002","requirement_id":"asset-002","type":"image/svg+xml","origin":"generation-request","status":"GENERATE","path":null,"source_url":null,"license":null,"creator":null,"retrieved_at":null,"usage_status":"pending","used_by":["shot-002"],"generation_purpose":"Monochrome evidence grid with right-side detail and left negative space"}
    ]
    manifest_path := path_join(workspace, "assets/asset-manifest.json")
    write_json(manifest_path, {"assets":assets})
    write_text(path_join(workspace, "assets/licenses.md"), "# Asset Rights\n\n- asset-001: first-party fixture authored for this offline proof; approved.\n- asset-002: generation request; not approved until generated and inspected.\n")
    write_text(path_join(workspace, "assets/source-log.md"), "# Source Log\n\nChecked bounded first-party fixture roots before generation. No external research, download, account, credential, or paid service was used.\n")
    evidence_path := path_join(workspace, "review/evidence/asset-accounting.json")
    write_json(evidence_path, {"requirements":2,"terminal_statuses":2,"counts":{"FOUND":1,"GENERATE":1,"CAPTURED":0,"NOT_REQUIRED":0,"BLOCKED":0},"all_accounted":true,"external_calls":0})
    artifacts := artifact_paths(workspace, ["assets/asset-manifest.json","assets/licenses.md","assets/source-log.md"])
    next := handoff(workspace, run_id, "asset-scout", "media-generator", "Generate only asset-002", artifacts, [evidence_path], "Every GENERATE record becomes an inspected local asset or BLOCKED")
    event(workspace, run_id, "asset-scout", "GENERATING", "one explicit generation request remains")
    return stage_receipt(workspace, run_id, "asset-scout", "completed", artifacts, [evidence_path], "economical-general", attempt, next)
}

func generated_svg() {
    return "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1920\" height=\"1080\" viewBox=\"0 0 1920 1080\"><rect width=\"1920\" height=\"1080\" fill=\"#fff\"/><g fill=\"#050505\"><rect x=\"1080\" y=\"140\" width=\"180\" height=\"180\"/><rect x=\"1300\" y=\"140\" width=\"380\" height=\"40\"/><rect x=\"1300\" y=\"210\" width=\"280\" height=\"32\"/><rect x=\"1080\" y=\"370\" width=\"600\" height=\"4\"/><rect x=\"1080\" y=\"430\" width=\"470\" height=\"32\"/><rect x=\"1080\" y=\"510\" width=\"600\" height=\"4\"/><rect x=\"1080\" y=\"570\" width=\"360\" height=\"32\"/><circle cx=\"1150\" cy=\"760\" r=\"70\"/><circle cx=\"1370\" cy=\"760\" r=\"70\"/><circle cx=\"1590\" cy=\"760\" r=\"70\"/></g></svg>\n"
}

func generation_stage(workspace, run_id, attempt) {
    checked := require_files(workspace, ["planning/shot-list.json","planning/style-plan.md","assets/asset-manifest.json"])
    if !checked["ok"] { return blocked(workspace, run_id, "media-generator", checked["code"], checked["error"], "economical-general", attempt) }
    loaded := load_object(path_join(workspace, "assets/asset-manifest.json"))
    if !loaded["ok"] { return blocked(workspace, run_id, "media-generator", loaded["code"], loaded["error"], "economical-general", attempt) }
    mut updated := []
    mut generated := []
    mut skipped := []
    for asset in get(loaded["value"], "assets", []) {
        if get(asset, "status", "") == "GENERATE" {
            output := path_join(workspace, "assets/generated/" + get(asset, "id", "generated") + ".svg")
            write_text(output, generated_svg())
            asset["origin"] = "generated-fixture"
            asset["status"] = "FOUND"
            asset["path"] = output
            asset["license"] = "project-generated fixture"
            asset["creator"] = "videoops deterministic fixture generator"
            asset["retrieved_at"] = "2026-09-04"
            asset["usage_status"] = "approved"
            asset["sha256"] = sha256_file(output)
            generated = push(generated, get(asset, "id", ""))
        } else { skipped = push(skipped, get(asset, "id", "")) }
        updated = push(updated, asset)
    }
    if len(generated) == 0 { return blocked(workspace, run_id, "media-generator", "no_generate_items", "manifest has no GENERATE items", "economical-general", attempt) }
    manifest_path := path_join(workspace, "assets/asset-manifest.json")
    write_json(manifest_path, {"assets":updated})
    evidence_path := path_join(workspace, "review/evidence/generation-selection.json")
    write_json(evidence_path, {"fixture_only":true,"live_provider":false,"generated_ids":generated,"skipped_non_generate_ids":skipped,"variants_per_item":1})
    artifacts := [manifest_path]
    for id in generated { artifacts = push(artifacts, path_join(workspace, "assets/generated/" + id + ".svg")) }
    next := handoff(workspace, run_id, "media-generator", "hyperframes-editor", "Build only from resolved approved assets", artifacts, [evidence_path], "HyperFrames draft passes deterministic technical gates")
    event(workspace, run_id, "media-generator", "PRODUCTION_READY", "all required assets resolved")
    return stage_receipt(workspace, run_id, "media-generator", "completed", artifacts, [evidence_path], "economical-general", attempt, next)
}

func unresolved_assets(manifest) {
    unresolved := []
    for asset in get(manifest, "assets", []) {
        status := get(asset, "status", "")
        usage := get(asset, "usage_status", "")
        path := get(asset, "path", null)
        if status == "GENERATE" || status == "BLOCKED" || usage != "approved" || type(path) != "string" || !path_is_file(path) { unresolved = push(unresolved, get(asset, "id", "unknown")) }
    }
    return unresolved
}

func composition_html(revised) {
    cta_color := "#777777"
    defect := " data-review-defect=\"cta-low-contrast\""
    if revised { cta_color = "#ffffff"; defect = "" }
    return "<!doctype html><html><head><meta charset=\"utf-8\"><title>VideoOps fixture</title><style>*{box-sizing:border-box}body{margin:0;background:#fff;font-family:Menlo,monospace}#stage{width:1920px;height:1080px;position:relative;overflow:hidden;background:#fff;color:#050505}.clip{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:120px}.card{border:8px solid #050505;padding:80px;font-size:82px;font-weight:700;background:#fff}.s2{background:#050505;color:#fff}.cta{background:#050505;color:" + cta_color + ";font-size:76px}</style></head><body><div id=\"stage\" data-composition-id=\"videoops-fixture\" data-no-timeline data-start=\"0\" data-width=\"1920\" data-height=\"1080\" data-duration=\"6\"><section id=\"hook\" class=\"clip\" data-start=\"0\" data-duration=\"2\" data-track-index=\"1\"><div class=\"card\">NOT ONE GIANT PROMPT</div></section><section id=\"thesis\" class=\"clip s2\" data-start=\"2\" data-duration=\"2\" data-track-index=\"1\"><div>FILES / BOUNDARIES / EVIDENCE</div></section><section id=\"cta\" class=\"clip cta\" data-start=\"4\" data-duration=\"2\" data-track-index=\"1\"" + defect + "><div>kujo run agent.kujo</div></section></div></body></html>\n"
}

func run_command(argv, cwd, timeout_ms) {
    process := spawn_process(argv, {"cwd":cwd,"timeout_ms":timeout_ms,"max_output_bytes":4194304})
    return {"exit_code":process.exitcode,"stdout":to_string(process.stdout),"stderr":to_string(process.stderr)}
}

func editor_stage(workspace, run_id, attempt, revision, finalize) {
    checked := require_files(workspace, ["planning/creative-brief.md","planning/transcript.md","planning/shot-list.json","planning/style-plan.md","assets/asset-manifest.json","intake/platform.json"])
    if !checked["ok"] { return blocked(workspace, run_id, "hyperframes-editor", checked["code"], checked["error"], "economical-code", attempt) }
    loaded := load_object(path_join(workspace, "assets/asset-manifest.json"))
    if !loaded["ok"] { return blocked(workspace, run_id, "hyperframes-editor", loaded["code"], loaded["error"], "economical-code", attempt) }
    unresolved := unresolved_assets(loaded["value"])
    if len(unresolved) > 0 { return blocked(workspace, run_id, "hyperframes-editor", "unresolved_required_assets", "unresolved production assets: " + join(unresolved, ", "), "economical-code", attempt) }
    if finalize {
        approval_loaded := load_object(path_join(workspace, "review/approval.json"))
        if !approval_loaded["ok"] || get(approval_loaded["value"], "status", "") != "PASS" { return blocked(workspace, run_id, "hyperframes-editor", "approval_required", "finalization requires PASS approval", "economical-code", attempt) }
        source := path_join(workspace, "output/revision-1.mp4")
        if !path_is_file(source) { source = path_join(workspace, "output/draft.mp4") }
        copy := run_command(["cp", source, path_join(workspace, "output/final.mp4")], workspace, 5000)
        if copy["exit_code"] != 0 { return blocked(workspace, run_id, "hyperframes-editor", "final_copy_failed", copy["stderr"], "economical-code", attempt) }
        metadata := {"schema":"videoops.output-metadata/v1","width":1920,"height":1080,"fps":30,"duration_seconds":6,"audio":true,"audio_fixture":"deterministic-local-reference-tone","sha256":sha256_file(path_join(workspace, "output/final.mp4")),"approved":true,"fixture":true}
        write_json(path_join(workspace, "output/metadata.json"), metadata)
        artifacts := artifact_paths(workspace, ["output/final.mp4","output/metadata.json"])
        next := handoff(workspace, run_id, "hyperframes-editor", "human-operator", "Deliver the approved fixture artifact", artifacts, [path_join(workspace, "review/approval.json")], "Human decides any publication or external use")
        event(workspace, run_id, "hyperframes-editor", "COMPLETE", "approved artifact finalized")
        return stage_receipt(workspace, run_id, "hyperframes-editor", "completed", artifacts, [path_join(workspace, "review/approval.json")], "economical-code", attempt, next)
    }
    if revision {
        fixes_loaded := load_object(path_join(workspace, "review/fix-list.json"))
        if !fixes_loaded["ok"] { return blocked(workspace, run_id, "hyperframes-editor", "fix_list_required", "revision mode requires review/fix-list.json", "economical-code", attempt) }
        mut issues := []
        for issue in get(fixes_loaded["value"], "issues", []) { issue["implementation_status"] = "APPLIED"; issues = push(issues, issue) }
        write_json(path_join(workspace, "review/fix-list.json"), {"issues":issues})
    }
    project := path_join(workspace, "production/hyperframes")
    ensure_dir(project)
    write_text(path_join(project, "index.html"), composition_html(revision))
    version := run_command(["npx","hyperframes","--version"], project, 30000)
    if version["exit_code"] != 0 { return blocked(workspace, run_id, "hyperframes-editor", "hyperframes_unavailable", version["stderr"], "economical-code", attempt) }
    check := run_command(["npx","hyperframes","check",project,"--json"], project, 120000)
    check_path := path_join(workspace, "review/evidence/hyperframes-check-" + to_string(attempt) + ".json")
    write_text(check_path, check["stdout"])
    if check["exit_code"] != 0 { return blocked(workspace, run_id, "hyperframes-editor", "hyperframes_check_failed", check["stderr"], "economical-code", attempt) }
    output_name := "draft.mp4"
    if revision { output_name = "revision-1.mp4" }
    output := path_join(workspace, "output/" + output_name)
    silent_output := path_join(workspace, "production/hyperframes/silent-" + output_name)
    ensure_dir(dirname(output))
    render := run_command(["npx","hyperframes","render",project,"-o",silent_output,"--fps","30","--quality","draft","--workers","2","--strict"], project, 240000)
    render_log_path := path_join(workspace, "production/render-log.md")
    write_text(render_log_path, "# Render Log\n\n- HyperFrames: " + trim(version["stdout"]) + "\n- Command: npx hyperframes render production/hyperframes -o production/hyperframes/silent-" + output_name + " --fps 30 --quality draft --workers 2 --strict\n- Audio: deterministic local 48 kHz reference tone, muxed with FFmpeg for audio-path verification only\n- Check exit: " + to_string(check["exit_code"]) + "\n- Render exit: " + to_string(render["exit_code"]) + "\n- Revision: " + to_string(revision) + "\n")
    if render["exit_code"] != 0 || !path_is_file(silent_output) { return blocked(workspace, run_id, "hyperframes-editor", "render_failed", render["stderr"], "economical-code", attempt) }
    mux := run_command(["ffmpeg","-y","-v","error","-i",silent_output,"-f","lavfi","-i","sine=frequency=440:sample_rate=48000:duration=6","-map","0:v:0","-map","1:a:0","-c:v","copy","-c:a","aac","-b:a","128k","-shortest",output], workspace, 120000)
    if mux["exit_code"] != 0 || !path_is_file(output) { return blocked(workspace, run_id, "hyperframes-editor", "audio_mux_failed", mux["stderr"], "economical-code", attempt) }
    probe := run_command(["ffprobe","-v","error","-show_entries","stream=codec_type,width,height,r_frame_rate","-show_entries","format=duration","-of","json",output], workspace, 30000)
    probe_path := path_join(workspace, "review/evidence/ffprobe-" + to_string(attempt) + ".json")
    write_text(probe_path, probe["stdout"])
    if probe["exit_code"] != 0 || contains(probe["stdout"], "1920") == 0 || contains(probe["stdout"], "1080") == 0 || contains(probe["stdout"], "30/1") == 0 || contains(probe["stdout"], "6.000000") == 0 || contains(probe["stdout"], "audio") == 0 { return blocked(workspace, run_id, "hyperframes-editor", "technical_gate_failed", "ffprobe metadata does not match 1920x1080, 30fps, 6s with audio", "economical-code", attempt) }
    write_text(path_join(workspace, "production/production-notes.md"), "# Production Notes\n\nThe fixture uses current HyperFrames 0.8.27 static clip timing with `data-no-timeline`; no external media, fonts, network, or provider calls. FFmpeg adds a deterministic 48 kHz reference tone to verify the audio mux and inspection path without implying finished narration. Revision mode applies every fix-list item and records APPLIED status.\n")
    artifacts := [project,render_log_path,path_join(workspace,"production/production-notes.md"),output]
    next := handoff(workspace, run_id, "hyperframes-editor", "video-critic", "Independently review the exact rendered candidate", artifacts, [check_path,probe_path], "Critic emits PASS or actionable FAIL")
    state := "DRAFT_READY"
    if revision { state = "REVIEWING" }
    event(workspace, run_id, "hyperframes-editor", state, "render and deterministic technical checks passed")
    return stage_receipt(workspace, run_id, "hyperframes-editor", "completed", artifacts, [check_path,probe_path], "economical-code", attempt, next)
}

func critic_stage(workspace, run_id, attempt, revision_count) {
    candidate := path_join(workspace, "output/draft.mp4")
    if revision_count > 0 { candidate = path_join(workspace, "output/revision-1.mp4") }
    checked := require_files(workspace, ["planning/creative-brief.md","planning/transcript.md","planning/shot-list.json","planning/style-plan.md","production/render-log.md"])
    if !checked["ok"] || !path_is_file(candidate) { return blocked(workspace, run_id, "video-critic", "missing_review_input", "required planning/render input is missing", "economical-multimodal", attempt) }
    project_html := read_file(path_join(workspace, "production/hyperframes/index.html"))
    defect := contains(project_html, "data-review-defect=\"cta-low-contrast\"") == 1
    probe := run_command(["ffprobe","-v","error","-show_entries","stream=codec_type,width,height,r_frame_rate","-show_entries","format=duration","-of","json",candidate], workspace, 30000)
    probe_path := path_join(workspace, "review/evidence/critic-ffprobe-" + to_string(revision_count) + ".json")
    write_text(probe_path, probe["stdout"])
    if probe["exit_code"] != 0 { return blocked(workspace, run_id, "video-critic", "invalid_video", probe["stderr"], "economical-multimodal", attempt) }
    dimensions := {"narrative_clarity":94,"hook_strength":92,"pacing":90,"visual_hierarchy":94,"motion_quality":88,"brand_fit":95,"audio_quality":100,"transcript_fidelity":94,"technical_quality":98,"cta_effectiveness":94}
    status := "PASS"
    if defect { status = "FAIL"; dimensions["visual_hierarchy"] = 40; dimensions["cta_effectiveness"] = 35 }
    approval := {"status":status,"reviewed_at":"2026-09-04T12:00:00-04:00","revision_count":revision_count,"confidence":0.98,"dimensions":dimensions}
    approval_path := path_join(workspace, "review/approval.json")
    write_json(approval_path, approval)
    issues := []
    critique := "# Video Critique\n\nPASS: planning, timing, hierarchy, technical render, and CTA meet the fixture acceptance contract.\n"
    outcome := "completed"
    if defect {
        issue := {"id":"fix-001","severity":"HIGH","timestamp":"00:04.000–00:06.000","frame_range":"120–179","problem":"CTA text uses low-contrast gray on black.","why_it_matters":"The concrete product action is the required ending and is not reliably readable.","required_change":"Change CTA text to white while preserving the black field and two-second dwell.","acceptance_criteria":"HyperFrames contrast check passes and the CTA remains visible for frames 120–179.","implementation_status":"PENDING"}
        issues = push(issues, issue)
        write_json(path_join(workspace, "review/fix-list.json"), {"issues":issues})
        critique = "# Video Critique\n\nFAIL. One HIGH defect blocks approval. At 00:04–00:06 the required CTA has inadequate contrast. Apply `fix-001`, rerender the exact composition, and resubmit.\n"
        outcome = "revision_required"
    }
    write_text(path_join(workspace, "review/critique.md"), critique)
    artifacts := artifact_paths(workspace, ["review/critique.md","review/approval.json"])
    next_owner := "human-operator"
    stop := "Approved artifact may be finalized; external publication remains a human decision"
    if defect { artifacts = push(artifacts, path_join(workspace, "review/fix-list.json")); next_owner = "hyperframes-editor"; stop = "Every fix-list issue has a terminal implementation status and the revised render is reviewed" }
    next := handoff(workspace, run_id, "video-critic", next_owner, "Apply exact review decision", artifacts, [probe_path], stop)
    state := "APPROVED"
    if defect { state = "REVISION_REQUIRED" }
    if revision_count >= 3 && defect { state = "BLOCKED"; outcome = "blocked" }
    event(workspace, run_id, "video-critic", state, "review outcome " + status)
    return stage_receipt(workspace, run_id, "video-critic", outcome, artifacts, [probe_path], "economical-multimodal", attempt, next)
}

export func run_stage(stage) {
    argv := args()
    workspace_arg := flag(argv, "--workspace", "")
    if workspace_arg == "" { eprint("missing --workspace"); exit(2) }
    safe := safe_workspace(workspace_arg)
    if !safe["ok"] { eprint(safe["error"]); exit(2) }
    workspace := safe["path"]
    ensure_dir(workspace)
    if !has_flag(argv, "--fixture") { eprint("live mode is intentionally unavailable; use --fixture or configure a future approved adapter"); exit(1) }
    run_id := flag(argv, "--run-id", "videoops-fixture-001")
    attempt_text := flag(argv, "--attempt", "1")
    attempt := to_int(attempt_text)
    if attempt < 1 || attempt > 3 { eprint("--attempt must be 1..3"); exit(2) }
    if attempt > 2 {
        defaults := {"creative-director":"economical-general","asset-scout":"economical-general","media-generator":"economical-general","hyperframes-editor":"economical-code","video-critic":"economical-multimodal"}
        escalation := {
            "stage":stage,"from_profile":get(defaults,stage,"economical-general"),"to_profile":premium_profile(stage),
            "reason":"two_economical_attempts_failed","attempts":2,"previous_gate":"FAIL","timestamp":"2026-09-04T12:00:00-04:00",
            "provider":null,"model":null,"input_tokens":null,"output_tokens":null,"latency_ms":null,"cost":null
        }
        write_json(path_join(workspace,"review/evidence/escalations/"+stage+".json"),escalation)
        event(workspace,run_id,stage,"STAGE_ESCALATED","failing stage routed from "+escalation["from_profile"]+" to "+escalation["to_profile"])
    }
    result := {}
    if stage == "creative-director" { result = creative_stage(workspace, run_id, attempt) }
    else if stage == "asset-scout" { result = asset_stage(workspace, run_id, attempt) }
    else if stage == "media-generator" { result = generation_stage(workspace, run_id, attempt) }
    else if stage == "hyperframes-editor" { result = editor_stage(workspace, run_id, attempt, has_flag(argv, "--revision"), has_flag(argv, "--finalize")) }
    else if stage == "video-critic" { result = critic_stage(workspace, run_id, attempt, to_int(flag(argv, "--revision-count", "0"))) }
    else { eprint("unknown VideoOps stage: " + stage); exit(2) }
    print(to_json_pretty(result))
    if get(result, "outcome", "blocked") == "blocked" { exit(1) }
}
