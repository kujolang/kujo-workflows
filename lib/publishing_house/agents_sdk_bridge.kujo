from src.agents.testing.no_network import create_no_network_harness
from src.agents.runner import create_agent_runner, run_agent
from src.agents.core_types import create_agent, create_agent_run_request

func flag(argv, name, fallback) {
    mut i := 0
    while i < len(argv) {
        if argv[i] == name && i + 1 < len(argv) { return to_string(argv[i + 1]) }
        i = i + 1
    }
    return fallback
}

func main() {
    argv := args()
    role := flag(argv, "--role", "fixture-agent")
    role_id := flag(argv, "--role-id", "fixture-agent")
    run_id := flag(argv, "--run-id", "run-fixture")
    assignment_id := flag(argv, "--assignment-id", "assignment-fixture")
    expected_output := flag(argv, "--expected-output", "agent-step-receipt")
    instructions_file := flag(argv, "--instructions-file", "")
    if instructions_file == "" || !path_is_file(instructions_file) || path_is_symlink(instructions_file) || file_size(instructions_file) > 524288 {
        print(to_json({"ok": false, "error": "instructions file is missing, unsafe, or exceeds 512 KiB"}))
        exit(1)
    }
    instructions := read_file(instructions_file)
    if trim(instructions) == "" {
        print(to_json({"ok": false, "error": "instructions file is empty"}))
        exit(1)
    }
    harness := create_no_network_harness({"model": {"output_text": "fixture proposal from " + role}})
    if harness["ok"] == false { print(to_json({"ok": false, "error": harness["error"]})); exit(1) }
    runner := create_agent_runner({"ai_adapter": harness["model_adapter"]})
    agent := create_agent({"id": role_id, "name": role, "instructions": instructions})
    request := create_agent_run_request("Produce " + expected_output + " for " + assignment_id, {"run_id": run_id + "-" + role_id, "session_id": "session-" + run_id})
    result := run_agent(runner, agent, request, {"tool_registry": harness["tool_registry"]})
    output := {}
    if type(result["output"]) == "dict" { output = result["output"] }
    output_text := ""
    if type(output) == "dict" && has_key(output, "text") == 1 { output_text = to_string(output["text"]) }
    print(to_json({
        "ok": result["status"] == "completed",
        "requires_network": false,
        "status": result["status"],
        "output_text": output_text,
        "step_count": len(result["steps"]),
        "artifact_count": len(result["artifacts"]),
        "instructions_sha256": sha256(instructions),
        "instructions_bytes": len(instructions),
        "agents_sdk_contract": "0.1.0"
    }))
    if result["status"] != "completed" { exit(1) }
}

main()
