from lib.publishing_house.common import get, has, flag_value, has_flag, parent_dir, ensure_dir, safe_path, read_json_object, write_json, permission_rank, secret_path, stable_ref

VERSION := "0.1.0"
CONTRACT_VERSION := "1.0.0"
FIXTURE_TIMES := ["2026-08-14T12:00:00Z","2026-08-14T12:05:00Z","2026-08-14T12:10:00Z","2026-08-14T12:15:00Z","2026-08-14T12:20:00Z","2026-08-14T12:25:00Z","2026-08-14T12:30:00Z","2026-08-14T12:35:00Z","2026-08-14T12:40:00Z","2026-08-14T12:45:00Z","2026-08-14T12:50:00Z","2026-08-14T12:55:00Z"]

func envelope(ok, data, error, code) {
    return {"ok": ok, "data": data, "error": error, "error_code": code, "workflow_contract_version": CONTRACT_VERSION}
}

func emit(ctx, ok, data, error, code) {
    output := envelope(ok, data, error, code)
    if ctx["json"] { print(to_json_pretty(output)) }
    else if ok { print(ctx["config"]["name"] + ": " + get(data, "outcome", get(data, "current_state", "completed")) + "\n" + get(data, "path", ctx["run_dir"])) }
    else { eprint(ctx["config"]["name"] + ": " + error + " [" + code + "]") }
}

func blocker(ctx, state, code, message, capability, next_action, retryable) {
    value := {
        "contract": "publishing-house.workflow-blocker/v1", "schema_name": "publishing-house.workflow-blocker", "schema_version": CONTRACT_VERSION,
        "workflow_id": ctx["workflow_id"], "workflow_version": VERSION, "run_id": ctx["request"]["run_id"], "created_at": ctx["request"]["created_at"],
        "state": state, "code": code, "message": message, "required_capability": capability, "next_action": next_action,
        "retryable": retryable, "external_effect_occurred": false
    }
    write_json(path_join(ctx["run_dir"], "blocker.json"), value)
    state_value := ctx["state"]
    state_value["status"] = state
    state_value["blocker"] = value
    ctx["state"] = state_value
    write_json(path_join(ctx["run_dir"], "state.json"), ctx["state"])
    return {"ok": false, "error": message, "code": code, "blocker": value}
}

func validate_request(workflow_id, config, request) {
    required := ["schema_name","schema_version","workflow_id","workflow_version","run_id","correlation_id","created_at","actor","permission_mode","mode","profiles","capabilities","input","external_effects_allowed"]
    for key in required { if has_key(request, key) == 0 { return {"ok": false, "code": "missing_required_field", "error": "missing required field: " + key} } }
    if request["schema_name"] != "publishing-house.workflow-run-request" || request["schema_version"] != CONTRACT_VERSION { return {"ok": false, "code": "incompatible_schema", "error": "workflow request schema must be publishing-house.workflow-run-request 1.0.0"} }
    if request["workflow_id"] != workflow_id || request["workflow_version"] != VERSION { return {"ok": false, "code": "workflow_mismatch", "error": "workflow identity or version mismatch"} }
    if !has(["OBSERVE","PROPOSE","ACT"], request["permission_mode"]) { return {"ok": false, "code": "invalid_permission", "error": "permission_mode must be OBSERVE, PROPOSE, or ACT"} }
    if permission_rank(request["permission_mode"]) > permission_rank(config["maximum_permission"]) { return {"ok": false, "code": "permission_broadened", "error": "request exceeds workflow maximum permission"} }
    if request["mode"] != "fixture" && request["mode"] != "live" { return {"ok": false, "code": "invalid_mode", "error": "mode must be fixture or live"} }
    if type(request["profiles"]) != "dict" || type(request["capabilities"]) != "array" || type(request["input"]) != "dict" { return {"ok": false, "code": "invalid_shape", "error": "profiles, capabilities, and input have invalid shapes"} }
    sensitive := secret_path(request, "")
    if sensitive != "" { return {"ok": false, "code": "secret_rejected", "error": "secret-shaped field rejected: " + sensitive} }
    return {"ok": true}
}

func capability_available(request, name) {
    for capability in request["capabilities"] {
        if type(capability) == "dict" && get(capability, "name", "") == name { return get(capability, "available", false) == true }
    }
    return false
}

func inspect_tool_contract(ctx, name) {
    expected := get(get(ctx["compatibility"], "tools", {}), name, null)
    if type(expected) != "dict" { return {"ok": false, "code": "incompatible_tool_contract", "error": "compatibility matrix has no entry for " + name} }
    repository := path_join(ctx["repos"], name)
    commit_process := spawn_process(["git", "-C", repository, "rev-parse", "HEAD"], {"cwd": ctx["root"], "timeout_ms": 10000, "max_output_bytes": 4096})
    status_process := spawn_process(["git", "-C", repository, "status", "--porcelain"], {"cwd": ctx["root"], "timeout_ms": 10000, "max_output_bytes": 65536})
    checkout_commit := trim(to_string(commit_process.stdout))
    if commit_process.exitcode != 0 || status_process.exitcode != 0 || checkout_commit != expected["commit"] || trim(to_string(status_process.stdout)) != "" {
        return {"ok": false, "code": "incompatible_tool_checkout", "error": name + " is not the clean tested commit", "expected_commit": expected["commit"], "checkout_commit": checkout_commit}
    }
    binary := path_join(repository, "bin/" + name)
    process := spawn_process(["env", "KUJO_BIN=" + ctx["kujo"], binary, "version", "--json"], {"cwd": ctx["root"], "timeout_ms": 30000, "max_output_bytes": 1048576})
    reported := null
    try { reported = parse_json(trim(to_string(process.stdout))) } except error { reported = null }
    if process.exitcode != 0 || type(reported) != "dict" || get(reported, "ok", false) != true {
        return {"ok": false, "code": "incompatible_tool_contract", "error": name + " version preflight failed"}
    }
    if get(reported, "tool_version", "") != expected["version"] || get(reported, "contract_version", "") != expected["contract_version"] {
        return {"ok": false, "code": "incompatible_tool_contract", "error": name + " does not match the tested tool and contract versions", "reported": reported, "expected": expected}
    }
    return {"ok": true, "tool_version": reported["tool_version"], "contract_version": reported["contract_version"], "tested_commit": expected["commit"], "verified_commit": checkout_commit}
}

func inspect_support_contract(ctx, name, matrix_key) {
    expected := get(ctx["compatibility"], matrix_key, null)
    if type(expected) != "dict" { return {"ok": false, "code": "incompatible_support_contract", "error": "compatibility matrix has no entry for " + name} }
    repository := path_join(ctx["repos"], name)
    commit_process := spawn_process(["git", "-C", repository, "rev-parse", "HEAD"], {"cwd": ctx["root"], "timeout_ms": 10000, "max_output_bytes": 4096})
    status_process := spawn_process(["git", "-C", repository, "status", "--porcelain"], {"cwd": ctx["root"], "timeout_ms": 10000, "max_output_bytes": 65536})
    commit := trim(to_string(commit_process.stdout))
    ok := commit_process.exitcode == 0 && status_process.exitcode == 0 && commit == expected["commit"] && trim(to_string(status_process.stdout)) == ""
    return {"ok": ok, "code": "incompatible_support_checkout", "error": name + " is not the clean tested contract checkout", "expected_commit": expected["commit"], "verified_commit": commit}
}

func validate_input_references(request) {
    references := get(request["input"], "fixture_record_references", [])
    if type(references) != "array" { return {"ok": false, "code": "invalid_record_reference", "error": "fixture_record_references must be an array"} }
    for reference in references {
        if type(reference) != "dict" || get(reference, "schema_version", "") != CONTRACT_VERSION || get(reference, "record_id", "") == "" || get(reference, "path", "") == "" || get(reference, "checksum", "") == "" {
            return {"ok": false, "code": "invalid_record_reference", "error": "record reference is incomplete or incompatible"}
        }
        reference_path := reference["path"]
        if !safe_path(reference_path) { return {"ok": false, "code": "unsafe_path", "error": "record reference path is unsafe"} }
        if !path_is_file(reference_path) { return {"ok": false, "code": "invalid_record_reference", "error": "record reference does not resolve"} }
        if sha256_file(reference_path) != reference["checksum"] { return {"ok": false, "code": "checksum_drift", "error": "record reference checksum drift"} }
    }
    return {"ok": true}
}

func preflight(ctx) {
    mut required := []
    mut missing := []
    for name in ctx["config"]["required_capabilities"] {
        available := capability_available(ctx["request"], name)
        if name == "kujo" { available = available && path_is_file(ctx["kujo"]) }
        if name == "dispatch" || name == "agents-sdk" || has(ctx["config"]["tools"], name) { available = available && path_is_dir(path_join(ctx["repos"], name)) }
        entry := {"name": name, "available": available, "required": true}
        if available && name != "dispatch" && name != "agents-sdk" && name != "kujo" && has(ctx["config"]["tools"], name) {
            inspected := inspect_tool_contract(ctx, name)
            entry["contract_preflight"] = inspected
            if !inspected["ok"] { available = false; entry["available"] = false; entry["failure_code"] = inspected["code"] }
        }
        required = push(required, entry)
        if !available { missing = push(missing, name) }
    }
    for dependency in [{"name":"kujo-agents","matrix_key":"kujo_agents"},{"name":"kujo-skills","matrix_key":"kujo_skills"}] {
        inspected := inspect_support_contract(ctx, dependency["name"], dependency["matrix_key"])
        available := inspected["ok"]
        required = push(required, {"name":dependency["name"],"available":available,"required":true,"contract_preflight":inspected})
        if !available { missing = push(missing, dependency["name"]) }
    }
    mut optional := []
    for name in ctx["config"]["optional_capabilities"] { optional = push(optional, {"name": name, "available": capability_available(ctx["request"], name), "required": false}) }
    receipt := {
        "contract": "publishing-house.capability-receipt/v1", "schema_name": "publishing-house.capability-receipt", "schema_version": CONTRACT_VERSION,
        "workflow_id": ctx["workflow_id"], "workflow_version": VERSION, "run_id": ctx["request"]["run_id"], "created_at": ctx["request"]["created_at"],
        "required": required, "optional": optional, "permission_mode": ctx["request"]["permission_mode"], "mode": ctx["request"]["mode"], "outcome": "completed"
    }
    if len(missing) > 0 { receipt["outcome"] = "blocked"; receipt["missing"] = missing }
    write_json(path_join(ctx["run_dir"], "capability-receipt.json"), receipt)
    if len(missing) > 0 { return blocker(ctx, "unavailable", "missing_required_capability", "required capability unavailable: " + join(missing, ", "), join(missing, ","), "install or declare the required local capability", false) }
    if ctx["request"]["mode"] == "live" { return blocker(ctx, "unavailable", "live_adapter_unavailable", "live mode requires explicitly configured provider adapters; fixture fallback is forbidden", "live-adapter", "configure and validate the required live adapters", false) }
    return {"ok": true}
}

func normalize_daily_packet(ctx) {
    source := get(ctx["request"]["input"], "source_packet", "")
    loaded := read_json_object(source)
    if !loaded["ok"] { return loaded }
    packet := loaded["value"]
    if get(packet, "schema_name", "") == "publishing-house.normalized-daily-packet" && get(packet, "schema_version", "") == CONTRACT_VERSION {
        write_json(path_join(ctx["run_dir"], "validated-daily-packet.json"), packet)
        return {"ok": true, "value": packet}
    }
    if type(get(packet, "entries", null)) == "array" {
        items := []
        for entry in packet["entries"] {
            items = push(items, {
                "item_id": get(entry, "id", ""), "status": get(get(entry, "agent", {}), "status", "idea"),
                "priority": get(get(entry, "agent", {}), "priority", "normal"), "title": get(entry, "title", ""), "detail": get(entry, "detail", ""),
                "campaign_id": get(get(entry, "editorial", {}), "campaignId", ""), "format_profile": "flagship-feature", "requires_assets": true,
                "source_signals": [], "due_at": get(entry, "date", "") + "T17:00:00Z"
            })
        }
        normalized := {
            "contract": "publishing-house.normalized-daily-packet/v1", "schema_name": "publishing-house.normalized-daily-packet", "schema_version": CONTRACT_VERSION,
            "packet_id": get(get(packet, "run", {}), "id", "calendar-adapter-packet"), "date": get(get(packet, "run", {}), "date", "2026-08-14"),
            "source_adapter": "content-calendar-agent-packet/v1", "items": items, "provenance": [{"kind": "adapter", "source": source}]
        }
        write_json(path_join(ctx["run_dir"], "validated-daily-packet.json"), normalized)
        return {"ok": true, "value": normalized}
    }
    return {"ok": false, "code": "invalid_daily_packet", "error": "source packet is neither normalized nor a supported content-calendar packet"}
}

func tool_state(ctx, tool) { return path_join(ctx["tool_state_root"], tool) }

func append_record_reference(ctx, ref) {
    path := path_join(ctx["run_dir"], "record-references.json")
    refs := []
    if path_is_file(path) { loaded := read_json_object(path); if loaded["ok"] { refs = get(loaded["value"], "references", []) } }
    refs = push(refs, ref)
    ctx["refs"] = refs
    write_json(path, {"schema_name":"publishing-house.record-reference-index","schema_version":CONTRACT_VERSION,"references":refs})
}

func tool_call(ctx, op, index) {
    tool := op["tool"]
    payload_path := path_join(ctx["run_dir"], "inputs/" + op["id"] + ".json")
    write_json(payload_path, op["payload"])
    argv := [path_join(ctx["repos"], tool + "/bin/" + tool)]
    for token in split(op["command"], " ") { argv = push(argv, token) }
    argv = concat(argv, ["--state", tool_state(ctx, tool), "--input", payload_path, "--actor", op["actor"], "--timestamp", FIXTURE_TIMES[index % len(FIXTURE_TIMES)], "--id", op["id"], "--json"])
    artifact := get(op, "artifact", "")
    if artifact != "" { argv = concat(argv, ["--path", artifact]) }
    output := get(op, "output", "")
    if output != "" { argv = concat(argv, ["--output", output]) }
    if get(op, "act", false) { argv = concat(argv, ["--act", "--yes"]) }
    if get(op, "dry_run", false) { argv = push(argv, "--dry-run") }
    process := spawn_process(concat(["env", "KUJO_BIN=" + ctx["kujo"]], argv), {"cwd": ctx["repos"], "timeout_ms": 30000, "max_output_bytes": 2097152})
    receipt_path := path_join(ctx["run_dir"], "tool-receipts/" + op["id"] + ".json")
    parsed := null
    try { parsed = parse_json(trim(to_string(process.stdout))) } except error { parsed = {"ok": false, "error": trim(to_string(process.stdout) + to_string(process.stderr))} }
    receipt := {"tool": tool, "command": op["command"], "record_id": op["id"], "exit_code": process.exitcode, "result": parsed, "fixture": true}
    write_json(receipt_path, receipt)
    if process.exitcode != 0 || type(parsed) != "dict" || get(parsed, "ok", false) != true { return {"ok": false, "code": "tool_failed", "error": tool + " " + op["command"] + " failed", "receipt": receipt_path} }
    expected := get(get(ctx["compatibility"], "tools", {}), tool, {})
    if get(parsed, "tool_version", "") != get(expected, "version", "") || get(parsed, "contract_version", "") != get(expected, "contract_version", "") {
        return {"ok": false, "code": "incompatible_tool_contract", "error": tool + " returned an incompatible tool or contract version", "receipt": receipt_path}
    }
    result_data := get(parsed, "data", {})
    actual_id := op["id"]
    if type(get(result_data, "record", null)) == "dict" { actual_id = get(result_data["record"], "id", actual_id) }
    else { actual_id = get(result_data, "id", actual_id) }
    record_path := path_join(tool_state(ctx, tool), "records/" + actual_id + ".json")
    if type(get(result_data, "storage", null)) == "dict" { record_path = get(result_data["storage"], "path", record_path) }
    checksum := ""
    if path_is_file(record_path) { checksum = sha256_file(record_path) }
    ref := stable_ref(tool, actual_id, parsed["contract_version"], parsed["tool_version"], record_path, checksum)
    append_record_reference(ctx, ref)
    return {"ok": true, "ref": ref, "receipt": receipt_path}
}

func run_ops(ctx, operations) {
    mut index := 0
    for op in operations {
        result := tool_call(ctx, op, index)
        if !result["ok"] { return result }
        index = index + 1
    }
    return {"ok": true}
}

func load_agent_contract(ctx, binding) {
    agents_root := path_join(ctx["repos"], "kujo-agents")
    skills_root := path_join(ctx["repos"], "kujo-skills")
    relative_paths := [
        "publishing-house/00-publishing-house.md",
        "publishing-house/00-quality-standard.md",
        "publishing-house/00-shared-contracts.md",
        "publishing-house/00-permission-model.md",
        "publishing-house/00-tool-workflow-map.md",
        replace(binding["canonical_agent"], "kujo-agents/", "")
    ]
    paths := []
    mut content := ""
    for relative in relative_paths {
        path := path_join(agents_root, relative)
        if !safe_path(path) || !path_is_file(path) || path_is_symlink(path) || file_size(path) > 131072 {
            return {"ok": false, "code": "agent_contract_unavailable", "error": "canonical agent contract is missing, unsafe, or too large: " + relative}
        }
        paths = push(paths, path)
        content = content + "\n\n<!-- source: " + relative + " -->\n\n" + read_file(path)
    }
    skill_relative := replace(binding["canonical_skill"], "kujo-agents/", "")
    skill_path := path_join(agents_root, skill_relative)
    if !safe_path(skill_path) || !path_is_file(skill_path) || path_is_symlink(skill_path) || file_size(skill_path) > 131072 {
        return {"ok": false, "code": "agent_contract_unavailable", "error": "canonical skill contract is missing, unsafe, or too large: " + binding["canonical_skill"]}
    }
    paths = push(paths, skill_path)
    content = content + "\n\n<!-- source: " + binding["canonical_skill"] + " -->\n\n" + read_file(skill_path)
    workflow_skill := path_join(skills_root, "skills/kujo-publishing-house-workflows/SKILL.md")
    if !safe_path(workflow_skill) || !path_is_file(workflow_skill) || path_is_symlink(workflow_skill) || file_size(workflow_skill) > 131072 {
        return {"ok": false, "code": "agent_contract_unavailable", "error": "canonical Publishing House workflow skill is unavailable"}
    }
    paths = push(paths, workflow_skill)
    content = content + "\n\n<!-- source: skills/kujo-publishing-house-workflows/SKILL.md -->\n\n" + read_file(workflow_skill)
    content = trim(content) + "\n\nFixture execution is proposal-only, offline, and may not broaden the supplied permission or tool boundary.\n"
    output := path_join(ctx["run_dir"], "agent-contracts/" + binding["role_slug"] + ".md")
    ensure_dir(parent_dir(output))
    write_file_atomic(output, content, true)
    return {"ok": true, "paths": paths, "instructions_path": output, "instructions_sha256": sha256(content), "instructions_bytes": len(content)}
}

func run_agents(ctx) {
    mut index := 0
    for binding in ctx["config"]["bindings"] {
        binding_profiles := get(binding, "format_profiles", [])
        selected_profile := get(ctx["request"]["input"], "format_profile", "flagship-feature")
        selected := len(binding_profiles) == 0 || has(binding_profiles, selected_profile)
        if selected {
        role := binding["canonical_role"]
        slug := binding["role_slug"]
        contract := load_agent_contract(ctx, binding)
        if !contract["ok"] { return contract }
        request_value := {
            "contract": "publishing-house.agent-step-request/v1", "schema_name": "publishing-house.agent-step-request", "schema_version": CONTRACT_VERSION,
            "workflow_id": ctx["workflow_id"], "workflow_version": VERSION, "run_id": ctx["request"]["run_id"],
            "assignment_id": "assignment-" + ctx["request"]["run_id"] + "-" + to_string(index + 1), "canonical_role": role,
            "role_contract": binding["canonical_agent"], "skill_contract": binding["canonical_skill"], "maximum_permission": binding["maximum_permission"],
            "current_permission": ctx["request"]["permission_mode"], "input_record_references": ctx["refs"], "allowed_tools": binding["allowed_tools"],
            "expected_output": binding["expected_output"], "stop_condition": binding["stop_condition"], "next_owner": binding["handoff_destination"],
            "contract_loaded": true, "contract_paths": contract["paths"], "instructions_path": contract["instructions_path"],
            "instructions_sha256": contract["instructions_sha256"], "instructions_bytes": contract["instructions_bytes"]
        }
        request_path := path_join(ctx["run_dir"], "agent-requests/" + to_string(index + 1) + "-" + slug + ".json")
        write_json(request_path, request_value)
        argv := ["env", "KUJO_MODULE_PATH=" + path_join(ctx["repos"], "agents-sdk"), ctx["kujo"], "run", path_join(ctx["root"], "lib/publishing_house/agents_sdk_bridge.kujo"), "--", "--role", role, "--role-id", slug, "--run-id", ctx["request"]["run_id"], "--assignment-id", request_value["assignment_id"], "--expected-output", binding["expected_output"], "--instructions-file", contract["instructions_path"]]
        process := spawn_process(argv, {"cwd": ctx["root"], "timeout_ms": 30000, "max_output_bytes": 1048576})
        sdk := null
        try { sdk = parse_json(trim(to_string(process.stdout))) } except error { sdk = {"ok": false, "error": trim(to_string(process.stdout) + to_string(process.stderr))} }
        receipt := request_value
        receipt["contract"] = "publishing-house.agent-step-receipt/v1"
        receipt["schema_name"] = "publishing-house.agent-step-receipt"
        receipt["outcome"] = "completed"
        receipt["artifact_references"] = []
        receipt["agents_sdk"] = {"commit": "0e56994f45f577f6e5dd68f2c3c0c7e06af46d71", "contract_version": "0.1.0", "requires_network": false, "result": sdk}
        if get(sdk, "instructions_sha256", "") != contract["instructions_sha256"] || get(sdk, "instructions_bytes", 0) != contract["instructions_bytes"] { receipt["outcome"] = "failed" }
        if process.exitcode != 0 || get(sdk, "ok", false) != true { receipt["outcome"] = "failed" }
        receipt_path := path_join(ctx["run_dir"], "agent-receipts/" + to_string(index + 1) + "-" + slug + ".json")
        write_json(receipt_path, receipt)
        ctx["agent_receipts"] = push(ctx["agent_receipts"], receipt_path)
        if receipt["outcome"] != "completed" { return {"ok": false, "code": "agent_step_failed", "error": "Agents SDK fixture step failed for " + role} }
        index = index + 1
        }
    }
    return {"ok": true}
}

func find_dispatch_run(output_root) {
    if !path_is_dir(output_root) { return "" }
    for name in sort(list_dir(output_root)) { if starts_with(name, "run-") && path_is_dir(path_join(output_root, name)) { return name } }
    return ""
}

func run_dispatch(ctx, approval_pause, resume) {
    output_root := path_join(ctx["run_dir"], "dispatch")
    ensure_dir(output_root)
    spec := path_join(ctx["workflow_dir"], "workflow.json")
    argv := []
    if resume {
        prior := read_json_object(path_join(ctx["run_dir"], "dispatch-receipt.json"))
        if !prior["ok"] { return {"ok": false, "code": "dispatch_receipt_missing", "error": "Dispatch receipt is required to resume"} }
        argv = [ctx["kujo"], "run", path_join(ctx["repos"], "dispatch/dispatch.kujo"), "resume", prior["value"]["run_id"], "--yes", "--non-interactive", "--output-root", output_root]
    } else {
        argv = [ctx["kujo"], "run", path_join(ctx["repos"], "dispatch/dispatch.kujo"), "demo", ctx["workflow_id"], "--workflow-file", spec, "--input-json", to_json({"topic": ctx["workflow_id"], "run_id": ctx["request"]["run_id"]}), "--non-interactive", "--output-root", output_root]
        if !approval_pause { argv = push(argv, "--yes") }
    }
    process := spawn_process(concat(["env", "DISPATCH_OFFLINE_FIXTURE=true", "DISPATCH_ALLOW_ANY_OUTPUT_ROOT=true", "DISPATCH_ALLOW_ANY_CONFIG_PATH=true", "KUJO_BIN=" + ctx["kujo"]], argv), {"cwd": path_join(ctx["repos"], "dispatch"), "timeout_ms": 180000, "max_output_bytes": 2097152})
    run_id := find_dispatch_run(output_root)
    if resume { prior := read_json_object(path_join(ctx["run_dir"], "dispatch-receipt.json")); if prior["ok"] { run_id = prior["value"]["run_id"] } }
    dispatch_state_path := path_join(output_root, run_id + "/state.json")
    status := "unknown"
    if path_is_file(dispatch_state_path) { parsed := read_json_object(dispatch_state_path); if parsed["ok"] { status = get(parsed["value"], "status", "unknown") } }
    receipt := {"engine": "dispatch", "version": "1.0.0", "commit": "3e8a5ff74919fd01e3674cfe47e3740206cd0afb", "exit_code": process.exitcode, "run_id": run_id, "status": status, "state": dispatch_state_path, "trace": path_join(output_root, run_id + "/trace.json"), "report": path_join(output_root, run_id + "/report.json"), "offline_fixture": true, "stdout_sha256": sha256(to_string(process.stdout)), "stderr_tail": substring(to_string(process.stderr), max(0, len(to_string(process.stderr)) - 2000), len(to_string(process.stderr)))}
    write_json(path_join(ctx["run_dir"], "dispatch-receipt.json"), receipt)
    if process.exitcode != 0 || run_id == "" { return {"ok": false, "code": "dispatch_failed", "error": "Dispatch orchestration failed"} }
    return {"ok": true, "receipt": receipt}
}

