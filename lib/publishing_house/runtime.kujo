func approval_prepare(ctx) {
    package := path_join(ctx["root"], "fixtures/publishing-house/primary-v2.fixture.md")
    checksum := sha256_file(package)
    provenance := [{"kind":"workflow-fixture","run_id":ctx["request"]["run_id"]}]
    ops := [
        {"tool":"galleypack","command":"freeze","id":"package-fixture-v2-frozen","actor":"production-editor","artifact":package,"payload":{"schema_version":"1.0.0","package_id":"package-fixture","package_version":"2","artifact_ids":["artifact-fixture-primary-v2","artifact-fixture-asset"],"review_ids":["review-fixture-final-v2"],"destination":"fixture-local","provenance":provenance}},
        {"tool":"versionseal","command":"request","id":"request-fixture-v2","actor":"production-editor","payload":{"schema_version":"1.0.0","package_id":"package-fixture","package_version":"2","manifest_checksum":checksum,"destinations":["fixture-local"],"actions":["publish"],"requested_by":"production-editor","expires_at":"2026-08-15T15:00:00Z","unresolved_queries":[],"provenance":provenance}}
    ]
    result := run_ops(ctx, ops)
    if !result["ok"] { return result }
    checksum = sha256_file(package)
    pause := {
        "contract":"publishing-house.approval-pause/v1","schema_name":"publishing-house.approval-pause","schema_version":CONTRACT_VERSION,
        "workflow_id":ctx["workflow_id"],"workflow_version":VERSION,"run_id":ctx["request"]["run_id"],"created_at":"2026-08-14T14:00:00Z",
        "package_id":"package-fixture","package_version":"2","checksum":checksum,"destination":"fixture-local","requested_action":"publish",
        "approval_owner":"fixture-human-approver","conditions":[],"unresolved_queries":[],"expires_at":"2026-08-15T15:00:00Z","fixture":true,
        "current_state":"paused","next_action":"resume with the exact fixture VersionSeal approval decision"
    }
    write_json(path_join(ctx["run_dir"], "approval-pause.json"), pause)
    state_value := ctx["state"]
    state_value["status"] = "paused"
    state_value["pause_checksum"] = checksum
    ctx["state"] = state_value
    write_json(path_join(ctx["run_dir"], "state.json"), ctx["state"])
    return {"ok": true, "pause": pause}
}

func approval_resume(ctx) {
    if ctx["request"]["permission_mode"] != "ACT" { return blocker(ctx, "blocked", "act_permission_denied", "publication requires explicit ACT permission", "ACT", "rerun with an authorized ACT request", false) }
    fault := get(ctx["request"]["input"], "fixture_fault", "")
    if fault != "" {
        fault_states := {
            "no_approval":"approval_required","wrong_package":"wrong_package","wrong_checksum":"checksum_drift","wrong_destination":"destination_mismatch",
            "wrong_action":"action_mismatch","expired_approval":"approval_expired","revoked_approval":"approval_revoked","changed_artifact":"checksum_drift",
            "missing_adapter":"adapter_unavailable","failed_preflight":"preflight_failed","fixture_external_publication":"fixture_external_effect_denied"
        }
        if has_key(fault_states, fault) == 1 { return blocker(ctx, "blocked", fault_states[fault], "injected fixture failure: " + fault, "versionseal", "correct the exact approval, package, permission, or adapter boundary", false) }
    }
    approval_path := ctx["fixture_approval"]
    fixture_result := read_json_object(approval_path)
    if !fixture_result["ok"] || get(fixture_result["value"], "fixture", false) != true || get(fixture_result["value"], "decision", "") != "approved" { return blocker(ctx, "rejected", "approval_invalid", "fixture resume requires an explicitly labeled approved fixture decision", "versionseal", "provide a valid fixture approval record", false) }
    package := path_join(ctx["root"], "fixtures/publishing-house/primary-v2.fixture.md")
    checksum := sha256_file(package)
    publication_record_id := "publication-" + substring(sha256("approve-fixture-v2\npublish\nfixture-local\n" + checksum), 0, 20)
    pause_result := read_json_object(path_join(ctx["run_dir"], "approval-pause.json"))
    if !pause_result["ok"] || checksum != get(pause_result["value"], "checksum", "") { return blocker(ctx, "blocked", "checksum_drift", "package bytes changed after the approval pause", "versionseal", "create a new package and approval request", false) }
    provenance := [{"kind":"fixture-human-decision","source":approval_path}]
    approve := {"tool":"versionseal","command":"approve","id":"approve-fixture-v2","actor":"fixture-human-approver","artifact":package,"payload":{"schema_version":"1.0.0","human_actor":"fixture-human-approver","package_id":"package-fixture","package_version":"2","manifest_checksum":checksum,"destination":"fixture-local","action":"publish","fixture":true,"conditions":[],"provenance":provenance}}
    first := tool_call(ctx, approve, 2)
    if !first["ok"] { return first }
    checksum = sha256_file(package)
    approval_record_path := path_join(tool_state(ctx, "versionseal"), "records/approve-fixture-v2.json")
    published := path_join(ctx["run_dir"], "published/package-v2.md")
    ops := [
        {"tool":"presswire","command":"preflight","id":"publication-fixture-preflight","actor":"publishing-operations-director","artifact":package,"payload":{"schema_version":"1.0.0","approval_id":"approve-fixture-v2","approval_record_path":approval_record_path,"manifest_checksum":checksum,"destination":"fixture-local","authorized_action":"publish","adapter":"local-filesystem","idempotency_key":"publishing-house-fixture-v2","fixture":true,"provenance":provenance}},
        {"tool":"presswire","command":"publish","id":"publication-fixture-v2","actor":"publishing-operations-director","artifact":package,"output":published,"act":true,"payload":{"schema_version":"1.0.0","approval_id":"approve-fixture-v2","approval_record_path":approval_record_path,"manifest_checksum":checksum,"destination":"fixture-local","authorized_action":"publish","adapter":"local-filesystem","idempotency_key":"publishing-house-fixture-v2","fixture":true,"provenance":provenance}},
        {"tool":"storydesk","command":"status","id":"event-fixture-approved","actor":"managing-editor","payload":{"schema_version":"1.0.0","record_id":"brief-fixture-primary","from_status":"ready_for_review","to_status":"approved","approval_id":"approve-fixture-v2","provenance":provenance}},
        {"tool":"storydesk","command":"status","id":"event-fixture-scheduled","actor":"managing-editor","payload":{"schema_version":"1.0.0","record_id":"brief-fixture-primary","from_status":"approved","to_status":"scheduled","destination":"fixture-local","provenance":provenance}},
        {"tool":"storydesk","command":"status","id":"event-fixture-published","actor":"managing-editor","payload":{"schema_version":"1.0.0","record_id":"brief-fixture-primary","from_status":"scheduled","to_status":"published","publication_receipt_id":publication_record_id,"provenance":provenance}}
    ]
    result := run_ops(ctx, ops)
    if !result["ok"] { return result }
    checksum = sha256_file(package)
    write_json(path_join(ctx["run_dir"], "external-effect.json"), {"occurred":true,"kind":"bounded-local-fixture-publication","presswire_record_id":"publication-fixture-v2"})
    write_json(path_join(ctx["run_dir"], "artifact-checksums.json"), {"checksums":[{"artifact":"approved-package","path":package,"checksum":checksum},{"artifact":"published-package","path":published,"checksum":sha256_file(published)}]})
    return {"ok": true}
}

func complete(ctx, outcome, next_action) {
    refs := []
    refs_result := read_json_object(path_join(ctx["run_dir"], "record-references.json"))
    if refs_result["ok"] { refs = get(refs_result["value"], "references", []) }
    agent_receipts := []
    agent_dir := path_join(ctx["run_dir"], "agent-receipts")
    if path_is_dir(agent_dir) { for name in sort(list_dir(agent_dir)) { if ends_with(name, ".json") { agent_receipts = push(agent_receipts, path_join(agent_dir, name)) } } }
    artifact_checksums := []
    checksums_result := read_json_object(path_join(ctx["run_dir"], "artifact-checksums.json"))
    if checksums_result["ok"] { artifact_checksums = get(checksums_result["value"], "checksums", []) }
    effect_occurred := path_is_file(path_join(ctx["run_dir"], "external-effect.json"))
    dispatch_receipt := read_json_object(path_join(ctx["run_dir"], "dispatch-receipt.json"))
    dispatch_artifacts := []
    if dispatch_receipt["ok"] { dispatch_artifacts = [dispatch_receipt["value"]] }
    summary := {
        "contract":"publishing-house.workflow-run-summary/v1","schema_name":"publishing-house.workflow-run-summary","schema_version":CONTRACT_VERSION,
        "workflow_id":ctx["workflow_id"],"workflow_version":VERSION,"run_id":ctx["request"]["run_id"],"correlation_id":ctx["request"]["correlation_id"],
        "parent_run_id":get(ctx["request"],"parent_run_id",null),"child_run_ids":get(ctx["request"],"child_run_ids",[]),"created_at":ctx["request"]["created_at"],
        "actor":ctx["request"]["actor"],"permission_mode":ctx["request"]["permission_mode"],"assignment_id":get(ctx["request"]["input"],"assignment_id","assignment-fixture"),
        "campaign_id":get(ctx["request"]["input"],"campaign_id","campaign-trustworthy-local-publishing"),"source_packet_reference":get(ctx["request"]["input"],"source_packet",null),
        "current_state":outcome,"next_action":next_action,"tool_record_references":refs,"artifact_checksums":artifact_checksums,
        "agent_step_receipts":agent_receipts,"dispatch_artifacts":dispatch_artifacts,"blocker":null,"approval_boundary":ctx["config"]["approval_boundaries"],
        "external_effect_declared":ctx["request"]["external_effects_allowed"],"external_effect_occurred":effect_occurred,
        "provenance":[{"kind":"publishing-house-workflow","workflow_id":ctx["workflow_id"],"fixture":true}]
    }
    summary_path := path_join(ctx["run_dir"], "run-summary.json")
    write_json(summary_path, summary)
    receipt := {
        "contract":"publishing-house.workflow-completion-receipt/v1","schema_name":"publishing-house.workflow-completion-receipt","schema_version":CONTRACT_VERSION,
        "workflow_id":ctx["workflow_id"],"workflow_version":VERSION,"run_id":ctx["request"]["run_id"],"correlation_id":ctx["request"]["correlation_id"],
        "created_at":ctx["request"]["created_at"],"actor":ctx["request"]["actor"],"permission_mode":ctx["request"]["permission_mode"],"outcome":outcome,
        "summary_reference":{"path":summary_path,"checksum":sha256_file(summary_path)},"receipt_references":refs,
        "external_effect_declared":ctx["request"]["external_effects_allowed"],"external_effect_occurred":effect_occurred,
        "idempotency_key":sha256(ctx["workflow_id"]+"\n"+ctx["request"]["run_id"]),"provenance":[{"kind":"fixture","run_id":ctx["request"]["run_id"]}]
    }
    receipt_path := path_join(ctx["run_dir"], "completion-receipt.json")
    write_json(receipt_path, receipt)
    state_value := ctx["state"]
    state_value["status"] = outcome
    state_value["completion_receipt"] = receipt_path
    state_value["tool_record_references"] = refs
    ctx["state"] = state_value
    write_json(path_join(ctx["run_dir"], "state.json"), ctx["state"])
    report := "# " + ctx["config"]["name"] + " fixture report\n\n- Run: " + ctx["request"]["run_id"] + "\n- Outcome: " + outcome + "\n- Permission: " + ctx["request"]["permission_mode"] + "\n- Tool records: " + to_string(len(refs)) + "\n- Agent steps: " + to_string(len(agent_receipts)) + "\n- External effect occurred: " + to_string(effect_occurred) + "\n- Next action: " + next_action + "\n"
    write_file_atomic(path_join(ctx["run_dir"], "report.md"), report, true)
    return {"outcome": outcome, "path": receipt_path, "run_dir": ctx["run_dir"], "summary": summary_path}
}

export func run_workflow(workflow_id) {
    argv := args()
    workflow_dir := path_absolute(".")
    root := parent_dir(workflow_dir)
    config_result := read_json_object(path_join(workflow_dir, "workflow.json"))
    if !config_result["ok"] { eprint("workflow.json is invalid"); exit(2) }
    config := config_result["value"]
    compatibility_result := read_json_object(path_join(root, "docs/publishing-house/compatibility-matrix.json"))
    if !compatibility_result["ok"] { eprint("compatibility matrix is invalid"); exit(2) }
    request_path := flag_value(argv, "--request", "fixtures/request.fixture.json")
    request_result := read_json_object(request_path)
    if !request_result["ok"] { print(to_json_pretty(envelope(false, null, request_result["error"], request_result["code"]))); exit(1) }
    request := request_result["value"]
    checked := validate_request(workflow_id, config, request)
    if !checked["ok"] { print(to_json_pretty(envelope(false, null, checked["error"], checked["code"]))); exit(1) }
    references_checked := validate_input_references(request)
    if !references_checked["ok"] { print(to_json_pretty(envelope(false, null, references_checked["error"], references_checked["code"]))); exit(1) }
    run_dir := flag_value(argv, "--out", path_join(workflow_dir, ".runs/" + request["run_id"]))
    if !safe_path(run_dir) { print(to_json_pretty(envelope(false, null, "unsafe output path", "unsafe_path"))); exit(1) }
    ensure_dir(run_dir)
    repos := env_or("KUJO_REPOS", parent_dir(root))
    kujo := env_or("KUJO_BIN", path_join(repos, "kujo/target/release/kujo"))
    tool_state_root := flag_value(argv, "--tool-state-root", path_join(run_dir, "tool-state"))
    ctx := {
        "root":root,"workflow_dir":workflow_dir,"workflow_id":workflow_id,"config":config,"request":request,"run_dir":run_dir,
        "repos":repos,"kujo":kujo,"compatibility":compatibility_result["value"],"tool_state_root":tool_state_root,"json":has_flag(argv,"--json"),"fixture_approval":flag_value(argv,"--fixture-approval",""),
        "refs":[],"agent_receipts":[],"artifact_checksums":[],"external_effect_occurred":false,
        "state":{"schema_name":"publishing-house.workflow-state","schema_version":CONTRACT_VERSION,"workflow_id":workflow_id,"workflow_version":VERSION,"run_id":request["run_id"],"correlation_id":request["correlation_id"],"status":"running","completed_steps":[],"retry_count":0,"max_retries":2}
    }
    state_path := path_join(run_dir, "state.json")
    if path_is_file(state_path) {
        existing := read_json_object(state_path)
        if existing["ok"] {
            ctx["state"] = existing["value"]
            if get(ctx["state"], "status", "") == "completed" {
                receipt := read_json_object(path_join(run_dir, "completion-receipt.json"))
                data := {"outcome":"completed","path":path_join(run_dir,"completion-receipt.json"),"idempotent_replay":true}
                if receipt["ok"] { data["receipt"] = receipt["value"] }
                emit(ctx, true, data, null, null)
                return
            }
        }
    } else { write_json(state_path, ctx["state"]) }
    preflight_result := preflight(ctx)
    if !preflight_result["ok"] { emit(ctx, false, null, preflight_result["error"], preflight_result["code"]); exit(1) }
    if workflow_id == "publishing-house-approval-publication" {
        if has_flag(argv, "--resume") {
            if get(ctx["state"], "status", "") != "paused" { result := blocker(ctx,"blocked","not_paused","run is not paused and cannot resume",null,"inspect the run state",false);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
            resumed := approval_resume(ctx)
            if !resumed["ok"] { emit(ctx,false,null,resumed["error"],resumed["code"]);exit(1) }
            dispatch_result := run_dispatch(ctx, true, true)
            if !dispatch_result["ok"] { result := blocker(ctx,"failed",dispatch_result["code"],dispatch_result["error"],"dispatch","inspect Dispatch artifacts",true);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
            agents := run_agents(ctx)
            if !agents["ok"] { result := blocker(ctx,"failed",agents["code"],agents["error"],"agents-sdk","inspect agent receipt",true);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
            data := complete(ctx,"completed","start publishing-house-post-publication")
            emit(ctx,true,data,null,null)
            return
        }
        prepared := approval_prepare(ctx)
        if !prepared["ok"] { result := blocker(ctx,"failed",get(prepared,"code","preparation_failed"),prepared["error"],null,"inspect tool receipt",false);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
        dispatch_result := run_dispatch(ctx, true, false)
        if !dispatch_result["ok"] { result := blocker(ctx,"failed",dispatch_result["code"],dispatch_result["error"],"dispatch","inspect Dispatch artifacts",true);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
        pause_data := complete(ctx,"paused","resume with exact fixture approval")
        state_value := ctx["state"]
        state_value["status"] = "paused"
        state_value["pause_checksum"] = prepared["pause"]["checksum"]
        ctx["state"] = state_value
        write_json(state_path,ctx["state"])
        emit(ctx,true,pause_data,null,null)
        return
    }
    operations := standard_ops(ctx)
    if !operations["ok"] { result := blocker(ctx,"failed",get(operations,"code","input_failed"),operations["error"],null,"correct the input packet",false);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
    tools := run_ops(ctx, operations["ops"])
    if !tools["ok"] { result := blocker(ctx,"failed",tools["code"],tools["error"],null,"inspect tool receipt",false);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
    agents := run_agents(ctx)
    if !agents["ok"] { result := blocker(ctx,"failed",agents["code"],agents["error"],"agents-sdk","inspect agent receipt",true);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
    dispatch_result := run_dispatch(ctx, false, false)
    if !dispatch_result["ok"] { result := blocker(ctx,"failed",dispatch_result["code"],dispatch_result["error"],"dispatch","inspect Dispatch artifacts",true);emit(ctx,false,null,result["error"],result["code"]);exit(1) }
    data := complete(ctx,"completed",get(config,"next_workflow","operator review"))
    emit(ctx,true,data,null,null)
}
